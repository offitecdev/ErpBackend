model Customer {
  id                    String                       @id
  tenantId              String
  companyName           String
  segment               String?
  customerType          String                       @default("PRIVATE")
  taxOffice             String?
  taxNumber             String?
  // Primary address as DISTINCT components — there is deliberately no single
  // free-text "address" field, and no component repeats another's meaning:
  //   companyName        → company / name
  //   address            → street + house number
  //   addressSupplement  → address supplement / apartment
  //   postalCode / city / state / country
  // `addressName` is only the list label of the entry ("Head office"), not a
  // part of the postal address. Screens and PDFs collapse the components to at
  // most two lines via `formatAddressLines()` (frontend `utils/address.ts`).
  addressName           String?
  address               String?
  addressSupplement     String?
  postalCode            String?
  city                  String?
  state                 String?
  country               String?
  mainPhone             String?
  mobilePhone           String?
  mainEmail             String?
  website               String?
  language              String?
  vatNumber             String?
  priceList             String?
  customerSource        String?
  responsibleFirstName  String?
  responsibleLastName   String?
  status                String                       @default("ACTIVE")
  isActive              Boolean                      @default(true)
  tenant                Tenant                       @relation(fields: [tenantId], references: [id])
  activities            CustomerActivity[]
  contacts              CustomerContact[]
  notes                 CustomerNote[]
  locations             CustomerLocation[]
  tenders               Tender[]
  projects              Project[]
  appointments          Appointment[]
  offerScheduleSlots    OfferScheduleSlot[]
  shipments             Shipment[]
  maintenanceContracts  MaintenanceContract[]
  serviceCalls          ServiceCall[]
  workOrders            WorkOrder[]
  salesOrders           SalesOrder[]
  invoices              Invoice[]
  productDiscounts      CustomerProductDiscount[]
  meetingActivities     MeetingActivity[]
  meetingParticipations MeetingActivityParticipant[] @relation("MeetingParticipantCustomer")
  crmCommunications     CrmCommunication[]
  crmTasks              CrmTask[]
  formSubmissions       FormSubmission[]
  formSubmissionLinks   FormSubmissionLink[]
  fieldNotes            FieldNote[]
  mailMessages          MailMessage[]

  @@index([tenantId], map: "Customer_tenantId_fkey")
  // Liste sıralamaları tenant içinde yapılır. Tek başına tenantId indeksi
  // MySQL'i her sayfada filesort'a zorluyordu; bileşik indeksler LIMIT'i
  // doğrudan indeksten karşılar.
  @@index([tenantId, companyName])
  @@index([tenantId, status, companyName])
  @@index([tenantId, vatNumber])
}

// Workspace "meeting activity" (a meeting or a lightweight task) shown on the
// CRM overview and the unified calendar. Participants can be staff members or
// customers, mixed freely.
model MeetingActivity {
  id                  String   @id
  tenantId            String
  // KALENDER-EINLADUNG (18.08.2026). `icalUid` ist zugleich der Schlüssel für
  // Termine, die AUS Outlook hereinkommen: trifft eine Einladung mit bekannter
  // UID ein, wird der vorhandene Eintrag aktualisiert statt ein zweiter
  // angelegt. `externalOrigin` = OUTLOOK bei importierten Terminen.
  icalUid             String?  @db.VarChar(191)
  icalSequence        Int      @default(0)
  inviteSentAt        DateTime?
  externalOrigin      String?  @db.VarChar(16)
  externalOrganizer   String?  @db.VarChar(255)
  // MEETING | TASK
  kind                String   @default("MEETING")
  title               String
  notes               String?  @db.Text
  // Bilgi (CC) e-posta adresleri — ["a@b.com", ...]; toplantı maillerinde kullanılır.
  ccEmails            Json?
  startTime           DateTime
  endTime             DateTime
  customerId          String?
  createdByEmployeeId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant       Tenant                       @relation(fields: [tenantId], references: [id])
  customer     Customer?                    @relation(fields: [customerId], references: [id])
  createdBy    Employee                     @relation("MeetingActivityCreator", fields: [createdByEmployeeId], references: [id])
  participants MeetingActivityParticipant[]

  @@index([tenantId, startTime])
  @@index([customerId])
  @@index([createdByEmployeeId])
  @@index([tenantId, icalUid])
}

model MeetingActivityParticipant {
  id              String  @id
  meetingId       String
  // EMPLOYEE | CUSTOMER — exactly one of employeeId/customerId is set.
  participantType String
  employeeId      String?
  customerId      String?

  meeting  MeetingActivity @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  employee Employee?       @relation("MeetingParticipantEmployee", fields: [employeeId], references: [id])
  customer Customer?       @relation("MeetingParticipantCustomer", fields: [customerId], references: [id])

  @@index([meetingId])
  @@index([employeeId])
  @@index([customerId])
}

// Per-customer default discount (%) for a specific article. Applied automatically
// when that article is added to a tender for the customer.
model CustomerProductDiscount {
  id         String   @id
  tenantId   String
  customerId String
  articleId  String
  discount   Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, articleId])
  @@index([tenantId])
  @@index([articleId])
}

model SalesOrder {
  id                  String    @id
  tenantId            String
  customerId          String?
  tenderId            String?   @unique
  projectId           String?
  parentSalesOrderId  String?
  revisionNumber      Int?
  // Sipariş kodu — ana sipariş AU-2026-10001, ek sipariş (Nachtrag/Zusatzauftrag)
  // NT-2026-10001. Sunucuda DocumentCounter'dan üretilir, her dilde aynıdır.
  // Ek siparişin kodu artık üst siparişten TÜRETİLMEZ (eskiden "…-N1"), kendi
  // NT- serisinden gelir; üst siparişe bağ `parentSalesOrderId` ile kurulur.
  orderNumber         String
  // Yeni numaralandırmadan önceki kod (AUF-A-2026-4474, SO-…, …-N1).
  legacyNumber        String?
  orderType           String
  status              String    @default("ORDERED")
  totalAmount         Float     @default(0)
  // Payment schedule copied from the tender at conversion (JSON percent array,
  // e.g. "[30,20,10,40]"); drives "bill next stage" suggestions. Null = free-form.
  paymentStages       String?
  createdByEmployeeId String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Business date shown to the user. For addon (Zusatzauftrag) orders this is the
  // original appointment date the extra work belongs to, which may predate createdAt
  // when the entry is made days later. createdAt stays the internal "unbilled since"
  // slice boundary; orderDate is display-only. Null falls back to createdAt.
  orderDate           DateTime?

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  customer         Customer?              @relation(fields: [customerId], references: [id])
  tender           Tender?                @relation(fields: [tenderId], references: [id])
  project          Project?               @relation(fields: [projectId], references: [id])
  parentSalesOrder SalesOrder?            @relation("SalesOrderAddons", fields: [parentSalesOrderId], references: [id])
  addonSalesOrders SalesOrder[]           @relation("SalesOrderAddons")
  createdBy        Employee               @relation(fields: [createdByEmployeeId], references: [id])
  reports          ProjectReport[]
  expenses         ProjectExpense[]
  appointments     Appointment[]
  extraMaterials   ProjectExtraMaterial[]
  invoices         Invoice[]

  @@index([tenantId])
  @@index([customerId])
  @@index([projectId])
  @@index([parentSalesOrderId])
  @@index([createdByEmployeeId])
  @@index([tenantId, orderNumber])
  @@index([tenantId, legacyNumber])
}

model CustomerContact {
  id               String   @id
  customerId       String
  // Denormalized from the owning customer so the tenant-wide contact list
  // ("Ansprechpartner") pages straight from an index instead of joining
  // Customer on every request. Set by every create path, backfilled once.
  tenantId         String
  firstName        String
  lastName         String
  title            String?
  phone            String?
  mobilePhone      String?
  email            String?
  notes            String?  @db.Text
  isPrimaryContact Boolean  @default(false)
  customer         Customer @relation(fields: [customerId], references: [id])
  communications   CrmCommunication[]
  crmTasks         CrmTask[]
  mailMessages     MailMessage[]

  @@index([customerId], map: "CustomerContact_customerId_fkey")
  @@index([tenantId, lastName, firstName])
}

// CRM communication history — one row per customer touchpoint (phone call,
// e-mail, meeting, note), written by Quick Entry / the communication page and
// read as a tenant-wide filterable list. Deliberately flat: no participants,
// no attachments; the calendar keeps using MeetingActivity.
model CrmCommunication {
  id                  String   @id
  tenantId            String
  customerId          String
  contactId           String?
  // PHONE | EMAIL | MEETING | NOTE
  channel             String
  note                String   @db.Text
  // Business date of the touchpoint (API defaults it to "now"); createdAt
  // stays the technical insert time.
  occurredAt          DateTime @default(now())
  createdByEmployeeId String
  createdAt           DateTime @default(now())

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact   CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy Employee         @relation("CrmCommunicationCreator", fields: [createdByEmployeeId], references: [id])

  @@index([tenantId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([contactId])
  @@index([createdByEmployeeId])
}

// Erinnerungs-Einstellung — je Belegart GENAU EINE (Vorgabe 15.08.2026):
// Vorlauf (erste Erinnerung so viele Tage VOR dem Bezugsdatum, höchstens 30)
// und Wiederholung (danach alle N Tage bis zum Bezugsdatum, das selbst noch
// einmal erinnert). Keine Arten, Richtungen oder Regel-Listen mehr.
//   QUOTE → Bezug Tender.validUntil (Angebot läuft ab)
//   ORDER → Bezug Tender.internalDeliveryDate des Auftrags (Liefertermin)
model ReminderSetting {
  id           String   @id
  tenantId     String
  // QUOTE | ORDER
  entityType   String
  enabled      Boolean  @default(true)
  leadDays     Int
  intervalDays Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, entityType])
}

// Merkt, dass ein Beleg zu einem Termin bereits erinnert wurde — sonst würde
// derselbe Termin bei jedem Takt des Hintergrunddienstes erneut feuern. Der
// Schlüssel hängt am TERMIN, nicht an der Einstellung: ein Speichern der
// Einstellung darf nicht alles noch einmal auslösen.
model ReminderDispatch {
  id         String   @id
  tenantId   String
  // QUOTE | ORDER
  entityType String
  entityId   String
  dueAt      DateTime
  firedAt    DateTime @default(now())

  @@unique([entityType, entityId, dueAt])
  @@index([tenantId, firedAt])
}

// CRM task / reminder ("ABC AG anrufen", "Offerte nachfassen"). A REMINDER is
// just a dated task without further ceremony; both share one list.
model CrmTask {
  id                  String    @id
  tenantId            String
  // TASK | REMINDER
  kind                String    @default("TASK")
  title               String
  customerId          String?
  // Ansprechpartner des Kunden (Kundenwahl samt Ansprechpartner, 15.08.2026).
  contactId           String?
  assigneeEmployeeId  String?
  dueDate             DateTime?
  // OPEN | DONE | INCOMPLETE. INCOMPLETE = "Nicht erledigt": entweder per Hand
  // (X-Knopf) oder automatisch, sobald der Termin einer offenen Aufgabe
  // verstrichen ist (Hintergrunddienst + Listenaufruf); "Zurückholen" macht
  // sie wieder OPEN.
  status              String    @default("OPEN")
  completedAt         DateTime?
  // Erinnerungen: gesetzt, sobald das Einblendfenster gezeigt WURDE. Ohne den
  // Stempel würde dieselbe Erinnerung bei jeder Abfrage erneut aufpoppen.
  // Bei kind=TASK immer null.
  notifiedAt          DateTime?
  // Erinnerungen aus dem Hintergrunddienst: Sprungziel ("Öffnen") und die
  // sprachneutralen Bausteine des Textes ({ template, number, customerName,
  // daysLeft }) — die Oberfläche setzt den Satz in der Sprache der Person
  // zusammen; `title` ist nur der deutsche Ersatztext.
  linkUrl             String?
  meta                Json?
  // Beleg, an den eine Erinnerung des Hintergrunddienstes hängt (QUOTE →
  // Tender.id, ORDER → SalesOrder.id). Läuft das Angebot ab (bzw. wird
  // angenommen/bestellt) oder ist der Auftrag abgeschlossen/storniert,
  // räumt der Dienst die Erinnerung darüber weg. Bei Hand-Erinnerungen null.
  entityType          String?
  entityId            String?
  // Wer die Aufgabe zugewiesen hat — der Name steht auf der Karte ("von …").
  createdByEmployeeId String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer  Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact   CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Erste/„Haupt“-Verantwortliche — Altspalte, wird aus `assignees` gespiegelt.
  assignee  Employee? @relation("CrmTaskAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: SetNull)
  createdBy Employee  @relation("CrmTaskCreator", fields: [createdByEmployeeId], references: [id])
  assignees CrmTaskAssignee[]
  notes     CrmTaskNote[]

  @@index([tenantId, status, dueDate])
  // Fällige, noch nicht gezeigte Erinnerungen — die Abfrage läuft im Takt von
  // Sekunden, sie darf die Tabelle nicht scannen.
  @@index([tenantId, kind, notifiedAt, dueDate])
  @@index([customerId])
  @@index([contactId])
  @@index([assigneeEmployeeId])
  @@index([createdByEmployeeId])
  @@index([entityType, entityId])
}

model CustomerNote {
  id                  String    @id
  customerId          String
  createdByEmployeeId String
  noteText            String    @db.Text
  noteType            String
  isHighlight         Boolean   @default(false)
  firstName           String?
  email               String?
  telephone           String?
  dateActivity        DateTime?
  createdAt           DateTime  @default(now())
  createdBy           Employee  @relation(fields: [createdByEmployeeId], references: [id])
  customer            Customer  @relation(fields: [customerId], references: [id])

  @@index([createdByEmployeeId], map: "CustomerNote_createdByEmployeeId_fkey")
  @@index([customerId], map: "CustomerNote_customerId_fkey")
}

model Document {
  id                   String   @id
  tenantId             String
  relatedEntityId      String
  entityType           String
  fileName             String
  fileUrl              String   @db.LongText
  fileType             String
  category             String?
  uploadedByEmployeeId String
  uploadedBy           Employee @relation(fields: [uploadedByEmployeeId], references: [id])

  @@index([uploadedByEmployeeId], map: "Document_uploadedByEmployeeId_fkey")
}

model CustomerActivity {
  id           String   @id
  customerId   String
  employeeId   String
  activityType String
  description  String?  @db.Text
  activityDate DateTime @default(now())
  referenceId  String?
  customer     Customer @relation(fields: [customerId], references: [id])

  @@index([customerId], map: "CustomerActivity_customerId_fkey")
  // Tender activity lookups filter by referenceId and render newest first.
  // Without this composite index every tender detail/log open scans the full
  // customer activity table and then sorts the matches.
  @@index([referenceId, activityDate])
}

model CustomerLocation {
  id            String   @id
  customerId    String
  name          String
  // Address list this entry belongs to: INSTALLATION (Projekt/Montage),
  // DELIVERY (Lieferung) or BILLING (Rechnung).
  kind          String   @default("INSTALLATION")
  // Same distinct components as Customer: `address` is the street + house
  // number, `addressSupplement` the supplement / apartment.
  address           String?
  addressSupplement String?
  city              String?
  postalCode        String?
  state             String?
  country           String?
  phone         String?
  email         String?
  contactPerson String?
  isPrimary     Boolean  @default(false)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id])

  @@index([customerId], map: "CustomerLocation_customerId_fkey")
}

/// Mehrere Verantwortliche je Aufgabe/Erinnerung (18.08.2026). `notifiedAt`
/// ist der Erinnerungs-Stempel JE PERSON: eine Erinnerung an drei Leute läutet
/// bei allen dreien einmal, nicht nur beim ersten, der sie sieht.
model CrmTaskAssignee {
  id         String    @id
  taskId     String
  employeeId String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  task     CrmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation("CrmTaskAssigneeRows", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@index([employeeId, notifiedAt])
}

/// Notizen (mit Bildern als Daten-URLs, wie die Rapport-Bilder) an einer
/// Aufgabe — der Verlauf auf der Aufgabenseite.
model CrmTaskNote {
  id               String   @id
  tenantId         String
  taskId           String
  authorEmployeeId String
  text             String   @db.Text
  images           Json?
  createdAt        DateTime @default(now())

  task   CrmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Employee @relation("CrmTaskNoteAuthor", fields: [authorEmployeeId], references: [id])

  @@index([taskId, createdAt])
}
