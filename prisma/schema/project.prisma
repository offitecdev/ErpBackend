enum ProjectStatus {
  AWAITING_APPROVAL
  ACTIVE
  ON_HOLD
  COMPLETED
  // Manager-only "Sonderabschluss": the project is force-closed by a project
  // manager, kept distinct from a regular COMPLETED so the UI can flag it.
  SPECIALLY_CLOSED
  CANCELLED
}

enum AppointmentStatus {
  AVAILABLE
  BOOKED
  COMPLETED
  CANCELLED
}

model Project {
  id                       String        @id
  tenantId                 String
  customerId               String
  tenderId                 String?       @unique
  managerId                String?
  // Proje kodu — PR-2026-10001. Sunucuda DocumentCounter'dan üretilir, her dilde
  // aynıdır. `projectName` serbest metindir ve kodun yerini TUTMAZ.
  projectNumber            String
  projectName              String
  status                   ProjectStatus @default(AWAITING_APPROVAL)
  plannedBudget            Float         @default(0)
  actualCost               Float         @default(0)
  overtimeHourlyRate       Float         @default(0)
  overtimeTolerancePercent Float         @default(15)

  startDate DateTime?
  endDate   DateTime?

  bookingToken String? @unique @db.VarChar(128)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  tender   Tender?   @relation(fields: [tenderId], references: [id])
  manager  Employee? @relation("ProjectManager", fields: [managerId], references: [id])

  phases            ProjectPhase[]
  reports           ProjectReport[]
  expenses          ProjectExpense[]
  appointments      Appointment[]
  projectVariations ProjectVariation[]
  extraMaterials    ProjectExtraMaterial[]
  addonRequests     ProjectAddonRequest[]
  shipments         Shipment[]
  salesOrders       SalesOrder[]
  invoices          Invoice[]

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, projectNumber])
}

model ProjectPhase {
  id                 String  @id
  projectId          String
  phaseName          String
  progressPercentage Float   @default(0)
  isCompleted        Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectReport {
  id            String   @id
  projectId     String
  salesOrderId  String?
  appointmentId String?
  employeeId    String
  reportDate    DateTime @default(now())
  reportType    String

  workDate             DateTime  @default(now())
  startedAt            DateTime?
  endedAt              DateTime?
  workedMinutes        Int       @default(0)
  plannedMinutesForDay Int       @default(0)
  overtimeMinutes      Int       @default(0)
  overtimeHourlyRate   Float     @default(0)
  overtimeCost         Float     @default(0)
  operationsDone       String    @db.Text
  technicalNotes       String?   @db.Text

  customerSignature   String?   @db.LongText
  /// Unterschrift des Technikers auf dem Montage-Rapport (neben der
  /// Kundensignatur; beide erscheinen im PDF).
  technicianSignature String?   @db.LongText
  technicianSignedAt  DateTime?
  isSigned            Boolean   @default(false)
  signedAt            DateTime?

  // Manager approval of the worked-hours / overtime. Set when an administrator
  // finishes the montaj, or automatically (autoApproved) by the end-of-day pass.
  hoursApprovedAt   DateTime?
  hoursApprovedById String?
  autoApproved      Boolean   @default(false)

  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  appointment   Appointment?         @relation("ProjectAppointmentReports", fields: [appointmentId], references: [id], onDelete: SetNull)
  employee      Employee             @relation(fields: [employeeId], references: [id])
  usedMaterials ReportMaterial[]
  images        ProjectReportImage[]
  logs          ProjectReportLog[]

  @@index([projectId])
  @@index([salesOrderId])
  @@index([appointmentId])
  @@index([employeeId])
  @@index([employeeId, reportDate])
  @@index([employeeId, salesOrderId, reportDate])
  // Aynı sipariş/gün saha raporu kontrolü.
  @@index([projectId, salesOrderId, workDate])
}

// Speicherprotokoll des Montage-Rapports: jede Speicherung/Fertigstellung/
// Signatur schreibt eine Zeile (wer, wann, was). Die Projektleiter-Ansicht
// zeigt sie über den Protokoll-Knopf im Rapport-Editor.
model ProjectReportLog {
  id         String   @id
  reportId   String
  employeeId String?
  action     String // SAVED | COMPLETED | SIGNED
  createdAt  DateTime @default(now())

  report   ProjectReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  employee Employee?     @relation(fields: [employeeId], references: [id])

  @@index([reportId, createdAt])
  @@index([employeeId])
}

model ProjectReportImage {
  id           String   @id
  reportId     String
  imageData    String   @db.LongText
  caption      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  report ProjectReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ReportMaterial {
  id         String  @id
  reportId   String
  articleId  String?
  quantity   Float
  costAtTime Float

  report  ProjectReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  article Article?      @relation(fields: [articleId], references: [id])

  @@index([reportId])
  @@index([articleId])
}

model ProjectExpense {
  id            String   @id
  projectId     String
  salesOrderId  String?
  appointmentId String?
  expenseType   String
  amount        Float
  description   String?  @db.Text
  expenseDate   DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  salesOrder  SalesOrder?  @relation(fields: [salesOrderId], references: [id])
  appointment Appointment? @relation("ProjectAppointmentExpenses", fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([salesOrderId])
  @@index([appointmentId])
}

model Appointment {
  id                         String                         @id
  tenantId                   String
  projectId                  String?
  salesOrderId               String?
  assignedTechId             String?
  customerId                 String?
  startTime                  DateTime
  endTime                    DateTime
  status                     AppointmentStatus              @default(AVAILABLE)
  notes                      String?                        @db.Text
  // Bilgi (CC) e-posta adresleri — ["a@b.com", ...]; randevu maillerinde kullanılır.
  ccEmails                   Json?
  isLocked                   Boolean                        @default(false)
  installationReminderSentAt DateTime?
  // KALENDER-EINLADUNG (18.08.2026): UID und Zählstand der iCalendar-Anfrage.
  // Die UID bleibt über alle Änderungen gleich — daran erkennt Outlook, dass
  // eine Aktualisierung DENSELBEN Termin meint und legt keinen zweiten an;
  // `icalSequence` muss dabei jedes Mal steigen, sonst verwirft Outlook sie.
  icalUid                    String?                        @db.VarChar(191)
  icalSequence               Int                            @default(0)
  inviteSentAt               DateTime?
  // WER DEN TERMIN ANGELEGT HAT (19.08.2026). Die automatische Teammail geht
  // an das Montageteam, die CC-Liste UND an diese Person — sie hat den Termin
  // gesetzt und muss die Bestaetigung im eigenen Posteingang haben.
  // Optional, weil Termine aus der Zeit davor niemanden hinterlegt haben.
  createdByEmployeeId        String?
  // MEHRTÄGIGER EINSATZ (24.08.2026). Ein Einsatz über drei oder vier Tage ist
  // KEINE Zeile mit einem Anfang am Montag und einem Ende am Donnerstag: jeder
  // Tag hat eigene Arbeitszeiten, einen eigenen Tagesrapport und eine eigene
  // Überstundenrechnung. Er ist deshalb EINE ZEILE JE TAG — und `seriesId` ist
  // das Band, das die Tage zusammenhält (Fenster, Mail, Unterlagen sprechen
  // von der Serie, Raster, Rapport und Abrechnung vom einzelnen Tag).
  // `dayIndex` ist die Nummer des Tages IM Einsatz ("Tag 2 von 4"), nicht sein
  // Datum — sie bleibt richtig, wenn ein Tag dazwischen herausfällt.
  seriesId                   String?
  dayIndex                   Int                            @default(0)
  // KALENDER-ETIKETT (25.08.2026). Die Farbe der Karte im Kalender wird
  // GEWAEHLT und nicht mehr aus der Uhr abgeleitet (CalendarLabel). Leer =
  // ohne Etikett: die Karte bleibt neutral.
  labelId                    String?
  series                     AppointmentSeries?             @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  label                      CalendarLabel?                 @relation(fields: [labelId], references: [id], onDelete: SetNull)
  tenant                     Tenant                         @relation(fields: [tenantId], references: [id])
  project                    Project?                       @relation(fields: [projectId], references: [id])
  salesOrder                 SalesOrder?                    @relation(fields: [salesOrderId], references: [id])
  assignedTechnician         Employee?                      @relation("ProjectAppointmentTechnician", fields: [assignedTechId], references: [id])
  customer                   Customer?                      @relation(fields: [customerId], references: [id])
  createdBy                  Employee?                      @relation("ProjectAppointmentCreator", fields: [createdByEmployeeId], references: [id])
  technicianAssignments      ProjectAppointmentAssignment[]
  reports                    ProjectReport[]                @relation("ProjectAppointmentReports")
  expenses                   ProjectExpense[]               @relation("ProjectAppointmentExpenses")
  extraMaterials             ProjectExtraMaterial[]         @relation("ProjectAppointmentExtraMaterials")

  @@index([tenantId])
  @@index([projectId])
  @@index([salesOrderId])
  @@index([assignedTechId])
  @@index([createdByEmployeeId])
  @@index([startTime, endTime])
  @@index([tenantId, status, startTime])
  @@index([tenantId, assignedTechId, status, startTime])
  // Kommt eine Einladung herein, wird an der UID geprüft, ob sie zu einem
  // EIGENEN Projekttermin gehört (dann ist sie unsere eigene Kopie und wird
  // übersprungen). Ohne diesen Index läuft das auf einen Tabellenscan hinaus.
  @@index([tenantId, icalUid])
  // Saha raporunun günlük planlanan süresini hesaplayan sorgu.
  @@index([projectId, salesOrderId, status, startTime, endTime])
  // Die Tage eines Einsatzes in ihrer Reihenfolge — jede Ansicht, die von
  // "Tag 2 von 4" spricht, liest genau darüber.
  @@index([seriesId, startTime])
  @@index([labelId])
}

/// MEHRTÄGIGER EINSATZ — DIE KLAMMER UM DIE TAGE (24.08.2026).
///
/// Vorgabe: ein Einsatz soll über mehrere aufeinanderfolgende Tage gehen
/// können, jeder Tag mit EIGENEN Arbeitszeiten. Die Tage bleiben einzelne
/// Termine (siehe Appointment.seriesId) — hier steht nur, was dem GANZEN
/// Einsatz gehört und in jedem einzelnen Tag doppelt stünde:
///   · das Begleitwort an die Monteurin (`coverNote`),
///   · die Unterlagen (Pläne, Fotos, PDF) — sie gelten für den ganzen Einsatz
///     und gehen den Kunden NICHTS an (sie verlassen das Haus nie per Mail).
///
/// Auch ein EINTÄGIGER Termin bekommt eine Serie. Damit hängt "Unterlagen" an
/// jedem Termin gleich, und ein Tag lässt sich später anhängen, ohne dass
/// vorher etwas umgebaut werden müsste.
model AppointmentSeries {
  id        String   @id
  tenantId  String
  coverNote String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  documents    AppointmentDocument[]

  @@index([tenantId])
}

/// TERMINUNTERLAGEN (24.08.2026). Begleitzettel, Fotos und PDF, die die
/// Monteurin auf dem Bildschirm braucht — NICHT für den Kunden: sie hängen an
/// keiner Einladung und an keiner Kundenmail, sie stehen nur im Programm unter
/// «Terminunterlagen».
///
/// DIE BYTES LIEGEN AUF DER PLATTE, nicht in der Zeile: `fileRef` ist ein
/// kurzer Verweis (LocalFileStorage), genau wie bei den Angebotsanhängen. Das
/// ist der Grund, warum das Anhängen SOFORT geht — die Datei reist roh
/// (multipart) statt als Base64 in einem JSON-Körper, der ein Drittel grösser
/// wäre und zweimal umkodiert werden müsste.
model AppointmentDocument {
  id           String   @id
  tenantId     String
  seriesId     String
  fileName     String
  contentType  String
  sizeBytes    Int
  fileRef      String   @db.VarChar(512)
  uploadedById String?
  createdAt    DateTime @default(now())

  series     AppointmentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  uploadedBy Employee?         @relation("AppointmentDocumentUploader", fields: [uploadedById], references: [id])

  @@index([seriesId, createdAt])
  @@index([tenantId])
  @@index([uploadedById])
}

model ProjectAppointmentAssignment {
  id            String   @id
  appointmentId String
  technicianId  String
  assignedAt    DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  technician  Employee    @relation("ProjectAppointmentAssignmentTech", fields: [technicianId], references: [id])

  @@unique([appointmentId, technicianId])
  @@index([appointmentId])
  @@index([technicianId])
  @@index([technicianId, appointmentId])
}

model OfferScheduleSlot {
  id             String   @id
  tenantId       String
  tenderId       String
  customerId     String
  assignedTechId String?
  startTime      DateTime
  endTime        DateTime
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  tenant                Tenant                        @relation(fields: [tenantId], references: [id])
  tender                Tender                        @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  customer              Customer                      @relation(fields: [customerId], references: [id])
  assignedTechnician    Employee?                     @relation("OfferScheduleSlotTechnician", fields: [assignedTechId], references: [id])
  technicianAssignments OfferScheduleSlotAssignment[]

  @@index([tenantId])
  @@index([tenderId])
  @@index([customerId])
  @@index([assignedTechId])
  @@index([startTime, endTime])
}

model OfferScheduleSlotAssignment {
  id           String   @id
  slotId       String
  technicianId String
  assignedAt   DateTime @default(now())

  slot       OfferScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  technician Employee          @relation("OfferScheduleSlotAssignmentTech", fields: [technicianId], references: [id])

  @@unique([slotId, technicianId])
  @@index([slotId])
  @@index([technicianId])
}

/// Zusatzmaterial rows. Since the material/product merge (2026-08-14) they
/// reference Article; the API keeps accepting `materialId` on the wire.
model ProjectExtraMaterial {
  id            String   @id
  projectId     String
  salesOrderId  String?
  appointmentId String?
  articleId     String
  quantity      Float
  unitPrice     Float
  description   String?  @db.Text
  addedAt       DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  salesOrder  SalesOrder?  @relation(fields: [salesOrderId], references: [id])
  appointment Appointment? @relation("ProjectAppointmentExtraMaterials", fields: [appointmentId], references: [id], onDelete: SetNull)
  article     Article      @relation(fields: [articleId], references: [id])

  @@index([projectId])
  @@index([salesOrderId])
  @@index([appointmentId])
  @@index([articleId])
}

model ProjectVariation {
  id            String  @id
  projectId     String
  requestedById String
  articleId     String
  quantity      Float
  description   String? @db.Text
  status        String  @default("PENDING")
  costAtTime    Float

  createdAt    DateTime  @default(now())
  resolvedById String?
  resolvedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id])

  @@index([projectId])
}

/// A technician's request that the manager turn the accumulated extra work
/// (extra materials / external expenses / overtime logged during installation)
/// into a Zusatzauftrag (addon order). Technicians can no longer create addon
/// orders directly — they raise a PENDING request that surfaces in the manager's
/// "additional order" section (and as a notification); the manager creates the
/// actual addon order, which marks matching requests HANDLED.
/// status: 'PENDING' | 'HANDLED' | 'DISMISSED'
model ProjectAddonRequest {
  id              String    @id
  tenantId        String
  projectId       String
  salesOrderId    String?
  appointmentId   String?
  requestedById   String
  requestedByName String?
  status          String    @default("PENDING")
  note            String?   @db.Text
  expenseTotal    Float     @default(0)
  materialTotal   Float     @default(0)
  overtimeTotal   Float     @default(0)
  total           Float     @default(0)
  createdAt       DateTime  @default(now())
  resolvedById    String?
  resolvedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
}

/// Checklist templates configured by an administrator under Settings.
/// Each template holds an ordered list of items grouped by category. An item
/// captures a Yes/No/Not-Applicable status plus an optional measurement value
/// (number or free text) when filled in on a delivery report.
/// items JSON shape: { id: string, category: string, label: string, measurement: boolean }[]
model ChecklistTemplate {
  id          String   @id
  tenantId    String
  name        String
  description String?  @db.Text
  items       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// A delivery (Teslim / Schlussrapport) report filled by a technician for an
/// installation appointment. It snapshots the chosen checklist and the answers
/// (Yes/No/Not-Applicable + optional measurement value) plus an optional
/// customer signature. Field-report visuals are referenced live from the
/// related project/appointment reports, not duplicated here.
/// responses JSON shape:
///   { id, category, label, status: 'YES'|'NO'|'NA', measurement: string, measurementEnabled: boolean }[]
model DeliveryReport {
  id                  String    @id
  tenantId            String
  projectId           String?
  salesOrderId        String?
  appointmentId       String?
  employeeId          String?
  checklistTemplateId String?
  checklistName       String?
  responses           Json
  notes               String?   @db.Text
  /// Report-eigene Fotoanhänge: [{ imageData: base64-DataURL, caption? }] —
  /// zusätzlich zu den live referenzierten Feldbericht-Bildern.
  images              Json?
  customerSignature   String?   @db.LongText
  /// Unterschrift des ausführenden Technikers — der Rapport trägt zwei
  /// Signaturen: Techniker (links) und Kunde (rechts).
  technicianSignature String?   @db.LongText
  technicianSignedAt  DateTime?
  isSigned            Boolean   @default(false)
  signedAt            DateTime?
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([appointmentId])
  @@index([projectId])
  @@index([salesOrderId])
  @@index([tenantId, employeeId, createdAt])
}

/// A tokenized customer signature request that can target any report kind
/// (field / delivery / general). The public sign page is rendered from `snapshot`
/// so even general reports — which are generated on the fly and not otherwise
/// persisted — can be previewed and signed without a login.
/// reportType: 'FIELD' | 'DELIVERY' | 'GENERAL'
/// snapshot JSON: a render-ready summary { title, customerName, projectName, sections, images }
model SignatureRequest {
  id              String    @id
  tenantId        String
  reportType      String
  reportId        String?
  projectId       String?
  token           String    @unique @db.VarChar(128)
  customerEmail   String?
  title           String?
  snapshot        Json
  status          String    @default("PENDING")
  signatureBase64 String?   @db.LongText
  signedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([reportType])
  @@index([reportId])
  @@index([tenantId, reportType, reportId])
}

model MailSetting {
  id                     String    @id
  tenantId               String    @unique
  fromName               String?
  fromEmail              String?
  replyTo                String?
  smtpHost               String?
  smtpPort               Int       @default(587)
  smtpSecure             Boolean   @default(false)
  smtpUser               String?
  smtpPassword           String?   @db.Text
  // GÖNDERİLENLER KOPYASI (2026-08-04): SMTP yalnızca teslim protokolüdür,
  // gönderenin kutusunda iz bırakmaz. Mailin Outlook'un "Gönderilmiş Öğeler"
  // klasöründe görünmesi için gönderim sonrası IMAP APPEND yapılır.
  // imapHost boşsa özellik kapalıdır. Kullanıcı/şifre boş bırakılırsa
  // SMTP'ninkiler kullanılır (çoğu sunucuda aynı hesap).
  imapHost               String?
  imapPort               Int       @default(993)
  imapSecure             Boolean   @default(true)
  imapUser               String?
  imapPassword           String?   @db.Text
  // Boşsa klasör sunucudan bulunur (RFC 6154 `\Sent`, sonra bilinen adlar).
  sentFolder             String?
  // Exchange gibi kopyayı sunucu tarafında dosyalayan kurulumlarda kapatılır
  // (MessageCopyForSMTPClientSubmissionEnabled) — yoksa mail iki kez görünür.
  saveToSent             Boolean   @default(true)
  // Tenant e-posta imzası: Outlook/Word'den yapıştırılabilen zengin HTML
  // (satır içi data URI görseller dâhil — bu yüzden LongText) + eski kayıtlar
  // için ayrı görsel alanı. Görseller gönderimde CID'li inline eke çevrilir —
  // data URI çoğu mail istemcisinde engellendiği için gövdede bırakılmaz.
  signatureHtml          String?   @db.LongText
  signatureImage         String?   @db.LongText
  // MICROSOFT-365-APP-REGISTRIERUNG (17.08.2026): Client-Id/-Secret/Azure-
  // Mandant der Entra-App, über die Mitarbeitende ihr Outlook-Postfach
  // verbinden. Secret verschlüsselt (mailCrypto.ts). Leer = Umgebung
  // (OFFITEC_MS_CLIENT_ID/_SECRET/_TENANT) gilt, sonst gar nichts.
  msClientId             String?   @db.VarChar(128)
  msClientSecret         String?   @db.Text
  msTenantId             String?   @db.VarChar(128)
  // Rückwärtiges Fenster der Erstsynchronisation in Tagen (Vorgabe 30).
  msSyncDays             Int       @default(30)
  // ── POSTEINGANG DES EIGENEN SERVERS (18.08.2026) ──────────────────────────
  // Eingehende Mail wird per IMAP vom EIGENEN Mailserver geholt (dieselben
  // Zugangsdaten wie die Gesendet-Kopie oben), nicht von Microsoft. Es wird
  // NICHT das ganze Postfach eingelesen: gespeichert wird nur, was zu einem
  // Kunden gehört — Antworten auf ERP-Mails (In-Reply-To/References) und Mail
  // von bekannten Kunden-/Ansprechpartneradressen. Alles andere wird gelesen,
  // verworfen und nie gespeichert.
  imapCaptureEnabled     Boolean   @default(false)
  // Zu überwachender Ordner (leer = INBOX).
  imapInboxFolder        String?
  // Nur Antworten auf ERP-Mails aufnehmen (strenger Modus); sonst zählen
  // zusätzlich alle Nachrichten bekannter Kundenadressen.
  imapCaptureRepliesOnly Boolean   @default(false)
  // Wie weit das Postfach zurueckreicht, in Monaten (1 oder 2; Vorgabe 2).
  // Steuert BEIDES: wie weit der Abruf zurueckliest und welchen Zeitraum die
  // Postfach-Seite aufschlaegt -- was man sieht, ist was das ERP fuehrt.
  imapWindowMonths       Int       @default(2)
  // Fortschritt: UIDVALIDITY schützt vor wiederverwendeten UIDs (Ordner neu
  // aufgebaut → alles ab vorne prüfen).
  imapUidValidity        BigInt?
  imapLastUid            BigInt?
  // GESENDETE POST (19.08.2026): der Ordner "Gesendet" wird mitgelesen, damit
  // auch das im ERP steht, was jemand aus Outlook heraus verschickt hat. Er
  // fuehrt einen EIGENEN Lesestand -- seine UIDs haben mit denen des
  // Posteingangs nichts zu tun. Ordnername: `sentFolder` (leer = am
  // `\Sent`-Merkmal des Servers gesucht).
  imapSentUidValidity    BigInt?
  imapSentLastUid        BigInt?
  imapLastSyncAt         DateTime?
  imapLastError          String?   @db.Text
  imapLastSummary        String?   @db.VarChar(255)
  // ── DER KALENDER DES POSTFACHS, DIREKT (CalDAV, 31.08.2026) ───────────────
  // Bis hierher kam ein Termin nur an, wenn jemand das Postfach EINGELADEN
  // hatte — was jemand sich selbst in den Kalender schreibt, erzeugte keine
  // Mail und blieb draussen. CalDAV liest den Kalender desselben Kontos
  // unmittelbar. Leer = aus; die Zugangsdaten sind standardmaessig die des
  // IMAP-Kontos (dasselbe Postfach, derselbe Server), `caldavUrl` wird per
  // /.well-known/caldav gesucht, wenn nichts eingetragen ist.
  caldavEnabled          Boolean   @default(false)
  caldavUrl              String?   @db.VarChar(512)
  caldavUser             String?   @db.VarChar(255)
  caldavPassword         String?   @db.Text
  // Die gefundenen Kalender (Adressen + Namen) aus der letzten Suche —
  // gespeichert, damit nicht jeder Durchgang die ganze Ermittlung wiederholt.
  caldavCalendars        Json?
  caldavLastSyncAt       DateTime?
  caldavLastError        String?   @db.Text
  caldavLastSummary      String?   @db.VarChar(255)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}
