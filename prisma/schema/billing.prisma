model Invoice {
  paymentStages String? @db.LongText
  id                 String    @id
  tenantId           String
  customerId         String?
  projectId          String?
  salesOrderId       String?
  // Fatura kodu — RE-2026-10001. Sunucuda DocumentCounter'dan üretilir ve her dilde
  // aynıdır (Rechnung/Invoice/Fatura ayrımı YOK).
  invoiceNumber      String
  // Yeni numaralandırmadan önceki kod (INV-2026-0001).
  legacyNumber       String?
  billingType        String    @default("FULL") // FULL | PARTIAL
  // Fatura türü — RECHNUNG (tam fatura, tüm pozisyonlar) | AKONTO (avans) |
  // ZWISCHEN (ara fatura) | SCHLUSS (kalan yüzdeyi kapatan son fatura).
  // billingType geriye dönük uyum için kalır: RECHNUNG/SCHLUSS → FULL,
  // AKONTO/ZWISCHEN → PARTIAL.
  kind               String    @default("RECHNUNG")
  // Rechnungsdatum / Fälligkeit — PDF üzerinde gösterilen iş tarihleri.
  invoiceDate        DateTime?
  dueDate            DateTime?
  // Tekliften kopyalanan meta (fatura kesildiği andaki değer dondurulur).
  salespersonName    String?
  commissionNumber   String?
  billedPercent      Float     @default(100)
  baseAmount         Float     @default(0) // order/project total this invoice was computed from
  // baseAmount * billedPercent / 100 — HARIC: hedefi %100'e tamamlayan
  // fatura (RECHNUNG/SCHLUSS) kalan FRANKI alir, boylece faturalarin
  // toplami sozlesme tutarina kurusu kurusuna oturur ve geriye 0.01 bile
  // kalmaz (bkz. CreateInvoiceUseCase).
  amount             Float     @default(0)
  status             String    @default("ISSUED") // ISSUED | PAID | CANCELLED
  notes              String?   @db.Text
  // ── DIREKTRECHNUNG (30.08.2026) ────────────────────────────────────────
  // Eine Rechnung OHNE Auftrag und ohne Projekt: der Benutzer fuellt die
  // Vorlage selbst aus. Empfaenger und Steuersatz stehen darum auf der
  // Rechnung selbst — es gibt keine Offerte, aus der sie nachgeladen werden
  // koennten. Bei Auftragsrechnungen bleiben die Felder leer und der PDF-Bau
  // liest weiter aus der Offerte.
  recipientName      String?
  recipientAddress   String?   @db.Text
  // Einleitungstext ueber der Positionstabelle ("Fuer die ausgefuehrten
  // Arbeiten erlauben wir uns zu berechnen:").
  introText          String?   @db.Text
  // Angewandter MWST-Satz. Eingefroren, damit ein spaeter geaenderter
  // Firmenwert eine bereits gestellte Rechnung nicht rueckwirkend verschiebt.
  vatRate            Float?
  // ── DIE DREI ABSCHNITTE DER DIREKTRECHNUNG (05.09.2026) ────────────────
  // Vorgabe Samet: der Beleg besteht aus DREI Abschnitten — Positionen,
  // Rabatt und Schlusstext — und jeder einzelne darf entfernt werden. Ein
  // entfernter Abschnitt verschwindet dann AUCH aus dem PDF.
  //
  // Gespeichert wird, welche Abschnitte GEDRUCKT werden, als JSON-Objekt
  // {"positions":true,"discount":true,"closing":false}. NULL heisst "alle
  // drei" — so drucken die vor diesem Umbau erstellten Rechnungen
  // unveraendert weiter ihre Positionen.
  sections           String?   @db.Text
  // Rabattstapel des Belegs — dieselbe Form wie `Tender.totalDiscounts`:
  // [{"name":"Mengenrabatt","kind":"PERCENT","value":5}, …]. Die Rabatte
  // greifen NACHEINANDER, jeder auf das, was der vorige uebrig laesst; die
  // MWST rechnet auf dem rabattierten Netto (siehe tenderDiscounts.utils.ts).
  discounts          String?   @db.Text
  // Schlusstext — der Absatz UNTER der Summe (Zahlungsbedingung, Dank,
  // Hinweis). Leer heisst: der Satz aus den Firmeneinstellungen. Gedruckt
  // wird er nur, solange der Abschnitt "closing" eingeschaltet ist.
  closingText        String?   @db.Text
  // Absenderzeile des Belegs. Vorbelegt aus den Mandanteneinstellungen
  // ("Offitec GmbH, Ceres Tower - Hohenrainstrasse 24, 4133 Pratteln"), je
  // Rechnung aenderbar und dann EINGEFROREN. Betrifft NUR die gedruckte
  // Zeile: der Glaeubiger des QR-Zahlteils kommt weiterhin aus den
  // Einstellungen, weil er mit dem Bankkonto uebereinstimmen MUSS.
  senderAddress      String?   @db.Text
  // Zahlungseingang — WANN die Rechnung bezahlt wurde. Gesetzt beim
  // Umschalten auf PAID (das Markieren traegt ein Datum), geleert beim
  // Zurueckdrehen auf ISSUED.
  paidAt             DateTime?
  // ── GEGENBELEG (17.09.2026, Schritt 6) ─────────────────────────────────
  // kind STORNO (hebt eine offene Rechnung auf) oder GUTSCHRIFT (gibt Geld
  // einer bezahlten zurück): eigener RE-Nummer, NEGATIVER Betrag, zeigt auf
  // die Rechnung, die er betrifft. `creditReason` steht wörtlich darauf.
  reversesInvoiceId  String?
  creditReason       String?   @db.Text
  issuedByEmployeeId String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  customer   Customer?         @relation(fields: [customerId], references: [id])
  project    Project?          @relation(fields: [projectId], references: [id])
  salesOrder SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  issuedBy   Employee          @relation("EmployeeIssuedInvoices", fields: [issuedByEmployeeId], references: [id])
  lineItems  InvoiceLineItem[]
  reversesInvoice Invoice?  @relation("InvoiceReversal", fields: [reversesInvoiceId], references: [id], onDelete: SetNull)
  reversals       Invoice[] @relation("InvoiceReversal")
  payments        InvoicePayment[]

  @@index([tenantId])
  @@index([customerId])
  @@index([projectId])
  @@index([salesOrderId])
  @@index([issuedByEmployeeId])
  // Die Rechnungsliste sortiert nach Rechnungsdatum (neueste zuoberst).
  @@index([tenantId, invoiceDate])
  @@index([tenantId, invoiceNumber])
  @@index([tenantId, legacyNumber])
  @@index([reversesInvoiceId])
}

model InvoiceLineItem {
  id          String  @id
  invoiceId   String
  description String  @db.Text
  sourceType  String // ORDER | OVERTIME | EXPENSE | EXTRA_MATERIAL | MANUAL
  sourceId    String?
  quantity    Float   @default(1)
  unitAmount  Float   @default(0)
  lineTotal   Float   @default(0)
  // Mengeneinheit der Zeile (Stk., Std., Pau. …) — nur die Direktrechnung
  // fuellt sie; Auftragszeilen sind Pauschalen.
  unit        String?
  // Reihenfolge auf dem Beleg. Ohne sie kaeme die Positionsliste in der
  // Reihenfolge zurueck, die der Server gerade liefert.
  sortOrder   Int     @default(0)
  // ── WIE AUF DER OFFERTE (05.09.2026) ──────────────────────────────────
  // Vorgabe Samet: „Die Rechnung muss GENAU der Offertentabelle entsprechen —
  // mit Beschreibung und allem." Die Positionstabelle des Belegs ist dieselbe
  // wie die des Angebots (Pos · Bezeichnung · Menge · E.-Preis · Rabatt ·
  // MWST · Betrag), also braucht eine Rechnungszeile dieselben Felder wie
  // eine Offertposition.
  //
  // Beschreibung UNTER der Bezeichnung — im PDF `longDescription`.
  longDescription String? @db.Text
  // Zeilenrabatt: der Stapel (Form wie `Position.discounts`) und daneben sein
  // kombinierter Prozentwert. Genau wie auf der Offerte ist `discount` ein
  // ABGELEITETER Spiegel des Stapels — wer die Grundlage aendert, muss ihn neu
  // ableiten (siehe tenderDiscounts.utils.ts).
  discounts       String? @db.Text
  discount        Float?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ── ZAHLUNGSEINGÄNGE (17.09.2026, Schritt 7 / G19) ─────────────────────────
// Eine Rechnung kann in Teilen bezahlt werden. Sie ist «bezahlt», sobald die
// Eingänge ihren Betrag decken; `Invoice.paidAt` ist dann der Tag des letzten.
// Bei einer Gutschrift ist ein Eingang die RÜCKZAHLUNG (Betrag negativ wie sie).
model InvoicePayment {
  id          String   @id
  tenantId    String
  invoiceId   String
  amount      Float
  // PAYMENT = Geld geflossen · OFFSET = mit offener Rechnung verrechnet
  kind        String   @default("PAYMENT") @db.VarChar(16)
  paidAt      DateTime
  note        String?  @db.VarChar(500)
  createdById String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@index([invoiceId])
}
