model Invoice {
  id                 String   @id
  tenantId           String
  customerId         String?
  projectId          String?
  salesOrderId       String?
  // Fatura kodu — RE-2026-10001. Sunucuda DocumentCounter'dan üretilir ve her dilde
  // aynıdır (Rechnung/Invoice/Fatura ayrımı YOK).
  invoiceNumber      String
  // Yeni numaralandırmadan önceki kod (INV-2026-0001).
  legacyNumber       String?
  billingType        String   @default("FULL") // FULL | PARTIAL
  // Fatura türü — RECHNUNG (tam fatura, tüm pozisyonlar) | AKONTO (avans) |
  // ZWISCHEN (ara fatura) | SCHLUSS (kalan yüzdeyi kapatan son fatura).
  // billingType geriye dönük uyum için kalır: RECHNUNG/SCHLUSS → FULL,
  // AKONTO/ZWISCHEN → PARTIAL.
  kind               String   @default("RECHNUNG")
  // Rechnungsdatum / Fälligkeit — PDF üzerinde gösterilen iş tarihleri.
  invoiceDate        DateTime?
  dueDate            DateTime?
  // Tekliften kopyalanan meta (fatura kesildiği andaki değer dondurulur).
  salespersonName    String?
  commissionNumber   String?
  billedPercent      Float    @default(100)
  baseAmount         Float    @default(0) // order/project total this invoice was computed from
  amount             Float    @default(0) // baseAmount * billedPercent / 100
  status             String   @default("ISSUED") // ISSUED | PAID | CANCELLED
  notes              String?  @db.Text
  issuedByEmployeeId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  customer   Customer?         @relation(fields: [customerId], references: [id])
  project    Project?          @relation(fields: [projectId], references: [id])
  salesOrder SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  issuedBy   Employee          @relation("EmployeeIssuedInvoices", fields: [issuedByEmployeeId], references: [id])
  lineItems  InvoiceLineItem[]

  @@index([tenantId])
  @@index([customerId])
  @@index([projectId])
  @@index([salesOrderId])
  @@index([issuedByEmployeeId])
  @@index([tenantId, invoiceNumber])
  @@index([tenantId, legacyNumber])
}

model InvoiceLineItem {
  id          String  @id
  invoiceId   String
  description String  @db.Text
  sourceType  String // ORDER | OVERTIME | EXPENSE | EXTRA_MATERIAL | MANUAL
  sourceId    String?
  quantity    Float   @default(1)
  unitAmount  Float   @default(0)
  lineTotal   Float   @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
