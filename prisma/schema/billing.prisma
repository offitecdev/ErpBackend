model Invoice {
  id                 String    @id
  tenantId           String
  customerId         String?
  projectId          String?
  salesOrderId       String?
  // Fatura kodu — RE-2026-10001. Sunucuda DocumentCounter'dan üretilir ve her dilde
  // aynıdır (Rechnung/Invoice/Fatura ayrımı YOK).
  invoiceNumber      String
  // Yeni numaralandırmadan önceki kod (INV-2026-0001).
  legacyNumber       String?
  billingType        String    @default("FULL") // FULL | PARTIAL
  // Fatura türü — RECHNUNG (tam fatura, tüm pozisyonlar) | AKONTO (avans) |
  // ZWISCHEN (ara fatura) | SCHLUSS (kalan yüzdeyi kapatan son fatura).
  // billingType geriye dönük uyum için kalır: RECHNUNG/SCHLUSS → FULL,
  // AKONTO/ZWISCHEN → PARTIAL.
  kind               String    @default("RECHNUNG")
  // Rechnungsdatum / Fälligkeit — PDF üzerinde gösterilen iş tarihleri.
  invoiceDate        DateTime?
  dueDate            DateTime?
  // Tekliften kopyalanan meta (fatura kesildiği andaki değer dondurulur).
  salespersonName    String?
  commissionNumber   String?
  billedPercent      Float     @default(100)
  baseAmount         Float     @default(0) // order/project total this invoice was computed from
  // baseAmount * billedPercent / 100 — HARIC: hedefi %100'e tamamlayan
  // fatura (RECHNUNG/SCHLUSS) kalan FRANKI alir, boylece faturalarin
  // toplami sozlesme tutarina kurusu kurusuna oturur ve geriye 0.01 bile
  // kalmaz (bkz. CreateInvoiceUseCase).
  amount             Float     @default(0)
  status             String    @default("ISSUED") // ISSUED | PAID | CANCELLED
  notes              String?   @db.Text
  // ── DIREKTRECHNUNG (30.08.2026) ────────────────────────────────────────
  // Eine Rechnung OHNE Auftrag und ohne Projekt: der Benutzer fuellt die
  // Vorlage selbst aus. Empfaenger und Steuersatz stehen darum auf der
  // Rechnung selbst — es gibt keine Offerte, aus der sie nachgeladen werden
  // koennten. Bei Auftragsrechnungen bleiben die Felder leer und der PDF-Bau
  // liest weiter aus der Offerte.
  recipientName      String?
  recipientAddress   String?   @db.Text
  // Einleitungstext ueber der Positionstabelle ("Fuer die ausgefuehrten
  // Arbeiten erlauben wir uns zu berechnen:").
  introText          String?   @db.Text
  // Angewandter MWST-Satz. Eingefroren, damit ein spaeter geaenderter
  // Firmenwert eine bereits gestellte Rechnung nicht rueckwirkend verschiebt.
  vatRate            Float?
  issuedByEmployeeId String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  customer   Customer?         @relation(fields: [customerId], references: [id])
  project    Project?          @relation(fields: [projectId], references: [id])
  salesOrder SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  issuedBy   Employee          @relation("EmployeeIssuedInvoices", fields: [issuedByEmployeeId], references: [id])
  lineItems  InvoiceLineItem[]

  @@index([tenantId])
  @@index([customerId])
  @@index([projectId])
  @@index([salesOrderId])
  @@index([issuedByEmployeeId])
  // Die Rechnungsliste sortiert nach Rechnungsdatum (neueste zuoberst).
  @@index([tenantId, invoiceDate])
  @@index([tenantId, invoiceNumber])
  @@index([tenantId, legacyNumber])
}

model InvoiceLineItem {
  id          String  @id
  invoiceId   String
  description String  @db.Text
  sourceType  String // ORDER | OVERTIME | EXPENSE | EXTRA_MATERIAL | MANUAL
  sourceId    String?
  quantity    Float   @default(1)
  unitAmount  Float   @default(0)
  lineTotal   Float   @default(0)
  // Mengeneinheit der Zeile (Stk., Std., Pau. …) — nur die Direktrechnung
  // fuellt sie; Auftragszeilen sind Pauschalen.
  unit        String?
  // Reihenfolge auf dem Beleg. Ohne sie kaeme die Positionsliste in der
  // Reihenfolge zurueck, die der Server gerade liefert.
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
