/// Company category ("Numara 1/2/3…"): an admin-defined bundle of enabled
/// module keys, scoped to a company tree (rootTenantId). A tenant mapped to a
/// profile only exposes that profile's modules — menus are filtered by it and
/// roles may only contain permissions of the enabled modules.
model ModuleProfile {
  id            String   @id
  rootTenantId  String
  profileNumber Int
  name          String
  moduleKeys    Json
  createdAt     DateTime @default(now())
  tenants       Tenant[]

  @@unique([rootTenantId, profileNumber])
}

model Tenant {
  id                     String                @id
  tenantName             String
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  parentTenantId         String?
  /// ŞİRKET NUMARASI — belge kodundaki bloğu belirler: blok = numara × 10000,
  /// yani numarası 4 olan şirket AN-2026-40001'den sayar (0 = bloksuz, 00001).
  /// Şirket kategorisinden BAĞIMSIZDIR: iki şirket aynı modül paketini
  /// paylaşıp farklı numara taşıyabilir. /settings/company-categories altında
  /// şirket başına düzenlenir; bkz. shared/documentNumber.ts.
  companyNumber          Int                   @default(0)
  moduleProfileId        String?
  moduleProfile          ModuleProfile?        @relation(fields: [moduleProfileId], references: [id])
  checkInQrSecret        String?               @db.VarChar(512)
  checkOutQrSecret       String?               @db.VarChar(512)
  workScheduleJson       Json?
  customers              Customer[]
  employees              Employee[]
  leaveTypes             LeaveType[]
  roles                  Role[]
  parentTenant           Tenant?               @relation("SubTenants", fields: [parentTenantId], references: [id])
  subTenants             Tenant[]              @relation("SubTenants")
  tenders                Tender[]
  articles               Article[]
  suppliers              Supplier[]
  articleSuppliers       ArticleSupplier[]
  locations              Location[]
  isProjectModuleEnabled Boolean               @default(false)
  projects               Project[]
  appointments           Appointment[]
  offerScheduleSlots     OfferScheduleSlot[]
  materials              Material[]
  mailSetting            MailSetting?
  shipments              Shipment[]
  maintenanceContracts   MaintenanceContract[]
  serviceCalls           ServiceCall[]
  workOrders             WorkOrder[]
  salesOrders            SalesOrder[]
  notifications          Notification[]
  invoices               Invoice[]
  checklistTemplates     ChecklistTemplate[]
  deliveryReports        DeliveryReport[]
  signatureRequests      SignatureRequest[]
  meetingActivities      MeetingActivity[]
  roleModuleConfigs      RoleModuleConfig[]

  @@index([parentTenantId], map: "Tenant_parentTenantId_fkey")
  @@index([moduleProfileId], map: "Tenant_moduleProfileId_fkey")
}

model Employee {
  id                            String                         @id
  tenantId                      String
  firstName                     String
  lastName                      String
  title                         String?
  departmentId                  String?
  roleName                      String?
  email                         String                         @unique
  phone                         String?
  address                       String?                        @db.Text
  passwordHash                  String
  /// Set on every password change; JWTs carry it as the `pwdAt` claim so all
  /// tokens issued before the change become invalid.
  passwordChangedAt             DateTime?
  isActive                      Boolean                        @default(true)
  /// Soft delete: a non-null value blocks login, refresh and every authorized request.
  /// Recoverable by an admin for 30 days (restore endpoint), then considered final.
  deletedAt                     DateTime?
  /// Admin ban: blocks login/refresh/restore permanently; the e-mail cannot re-register.
  bannedAt                      DateTime?
  hireDate                      DateTime?
  terminationDate               DateTime?
  annualLeaveEntitlement        Int                            @default(0)
  profilePictureUrl             String?
  notes                         String?                        @db.Text
  /// Personal module package: subset of module keys this employee can see.
  /// null = no restriction (sees everything the company's category allows).
  moduleKeys                    Json?
  /// Companies (tenants) of the tree this employee may work in / switch to.
  /// null = no restriction (every tenant of the company tree, as before).
  /// Ids outside the own tree are ignored — the list may only ever narrow it.
  allowedTenantIds              Json?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @default(now()) @updatedAt
  attendanceLogs                AttendanceLog[]
  customerNotes                 CustomerNote[]
  uploadedDocs                  Document[]
  tenant                        Tenant                         @relation(fields: [tenantId], references: [id])
  employeeRoles                 EmployeeRole[]
  approvedLeaves                LeaveRequest[]                 @relation("ApprovedLeaves")
  leaveRequests                 LeaveRequest[]                 @relation("EmployeeLeaves")
  createdTenders                Tender[]
  stockMovements                StockMovement[]
  purchaseProposals             PurchaseProposal[]
  projects                      Project[]                      @relation("ProjectManager")
  projectAppointments           Appointment[]                  @relation("ProjectAppointmentTechnician")
  projectAppointmentAssignments ProjectAppointmentAssignment[] @relation("ProjectAppointmentAssignmentTech")
  offerScheduleSlots            OfferScheduleSlot[]            @relation("OfferScheduleSlotTechnician")
  offerScheduleSlotAssignments  OfferScheduleSlotAssignment[]  @relation("OfferScheduleSlotAssignmentTech")
  projectReports                ProjectReport[]
  assignedMaintenanceTasks      MaintenanceTask[]              @relation("MaintenanceTech")
  alternativeMaintenanceTasks   MaintenanceTask[]              @relation("MaintenanceAltTech")
  maintenanceTaskAssignments    MaintenanceTaskAssignment[]    @relation("MaintenanceTaskAssignmentTech")
  maintenanceReports            MaintenanceReport[]            @relation("MaintenanceReportTech")
  notifications                 Notification[]                 @relation("EmployeeNotifications")
  assignedServiceCalls          ServiceCall[]                  @relation("ServiceCallTech")
  alternativeServiceCalls       ServiceCall[]                  @relation("ServiceCallAltTech")
  serviceReports                ServiceReport[]                @relation("ServiceReportTech")
  createdSalesOrders            SalesOrder[]
  issuedInvoices                Invoice[]                      @relation("EmployeeIssuedInvoices")
  createdMeetingActivities      MeetingActivity[]              @relation("MeetingActivityCreator")
  meetingParticipations         MeetingActivityParticipant[]   @relation("MeetingParticipantEmployee")

  @@index([tenantId], map: "Employee_tenantId_fkey")
}

/// Append-only record of sensitive operations: who, when, from which IP,
/// which action, on which entity. Written fire-and-forget by AuditLogService.
model AuditLog {
  id         String   @id
  tenantId   String?
  employeeId String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?  @db.VarChar(512)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([employeeId])
  @@index([action])
}

/// Roles are shared across the whole company tree (one identical list under
/// the main tenant and every sub-tenant); new roles are created under the
/// root. Permissions are part of the shared role; the module package is
/// configured per entity via RoleModuleConfig.
model Role {
  id            String             @id
  tenantId      String
  roleName      String
  employees     EmployeeRole[]
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  permissions   RolePermission[]
  moduleConfigs RoleModuleConfig[]

  @@index([tenantId], map: "Role_tenantId_fkey")
}

/// Per-entity module package of a shared role: the same role can enable
/// different modules in each company of the tree (e.g. Offitec, Offitec AG,
/// Offitec Group). No row for (role, tenant) = no restriction there.
model RoleModuleConfig {
  roleId     String
  tenantId   String
  moduleKeys Json
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([roleId, tenantId])
  @@index([tenantId])
}

model Permission {
  id             String           @id
  permissionName String           @unique
  roles          RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model EmployeeRole {
  employeeId String
  roleId     String
  employee   Employee @relation(fields: [employeeId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@id([employeeId, roleId])
  @@index([roleId], map: "EmployeeRole_roleId_fkey")
}

model LeaveType {
  id       String         @id
  tenantId String
  typeName String
  requests LeaveRequest[]
  tenant   Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "LeaveType_tenantId_fkey")
}

model LeaveRequest {
  id           String    @id
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  description  String?   @db.Text
  status       String    @default("Pending")
  approvedById String?
  createdAt    DateTime  @default(now())
  approvedBy   Employee? @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  employee     Employee  @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([approvedById], map: "LeaveRequest_approvedById_fkey")
  @@index([employeeId], map: "LeaveRequest_employeeId_fkey")
  @@index([leaveTypeId], map: "LeaveRequest_leaveTypeId_fkey")
}

model AttendanceLog {
  id               String    @id
  employeeId       String
  logDate          DateTime  @default(now())
  checkInTime      DateTime
  checkOutTime     DateTime?
  /// [{ "start": "ISO", "end": "ISO" | null }] — end null açık mola
  breakPeriodsJson Json?
  /// Çıkış anında hesaplanan net çalışma (mola hariç), saniye
  netWorkSeconds   Int?
  isManualEdit     Boolean   @default(false)
  editedById       String?
  employee         Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "AttendanceLog_employeeId_fkey")
}
