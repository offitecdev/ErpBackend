/// Company category ("Numara 1/2/3…"): an admin-defined bundle of enabled
/// module keys, scoped to a company tree (rootTenantId). A tenant mapped to a
/// profile only exposes that profile's modules — menus are filtered by it and
/// roles may only contain permissions of the enabled modules.
model ModuleProfile {
  id            String   @id
  rootTenantId  String
  profileNumber Int
  name          String
  moduleKeys    Json
  createdAt     DateTime @default(now())
  tenants       Tenant[]

  @@unique([rootTenantId, profileNumber])
}

model Tenant {
  id                     String                @id
  tenantName             String
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  parentTenantId         String?
  /// ŞİRKET NUMARASI — belge kodundaki bloğu belirler: blok = numara × 10000,
  /// yani numarası 4 olan şirket AN-2026-40001'den sayar (0 = bloksuz, 00001).
  /// Şirket kategorisinden BAĞIMSIZDIR: iki şirket aynı modül paketini
  /// paylaşıp farklı numara taşıyabilir. /settings/company-categories altında
  /// şirket başına düzenlenir; bkz. shared/documentNumber.ts.
  companyNumber          Int                   @default(0)
  moduleProfileId        String?
  moduleProfile          ModuleProfile?        @relation(fields: [moduleProfileId], references: [id])
  checkInQrSecret        String?               @db.VarChar(512)
  checkOutQrSecret       String?               @db.VarChar(512)
  workScheduleJson       Json?
  customers              Customer[]
  employees              Employee[]
  leaveTypes             LeaveType[]
  roles                  Role[]
  parentTenant           Tenant?               @relation("SubTenants", fields: [parentTenantId], references: [id])
  subTenants             Tenant[]              @relation("SubTenants")
  tenders                Tender[]
  articles               Article[]
  suppliers              Supplier[]
  articleSuppliers       ArticleSupplier[]
  locations              Location[]
  isProjectModuleEnabled Boolean               @default(false)
  projects               Project[]
  appointments           Appointment[]
  offerScheduleSlots     OfferScheduleSlot[]
  mailSetting            MailSetting?
  shipments              Shipment[]
  maintenanceContracts   MaintenanceContract[]
  serviceCalls           ServiceCall[]
  workOrders             WorkOrder[]
  salesOrders            SalesOrder[]
  notifications          Notification[]
  invoices               Invoice[]
  checklistTemplates     ChecklistTemplate[]
  deliveryReports        DeliveryReport[]
  signatureRequests      SignatureRequest[]
  meetingActivities      MeetingActivity[]
  roleModuleConfigs      RoleModuleConfig[]

  @@index([parentTenantId], map: "Tenant_parentTenantId_fkey")
  @@index([moduleProfileId], map: "Tenant_moduleProfileId_fkey")
}

model Employee {
  id                            String                         @id
  tenantId                      String
  firstName                     String
  lastName                      String
  title                         String?
  departmentId                  String?
  roleName                      String?
  email                         String                         @unique
  phone                         String?
  address                       String?                        @db.Text
  passwordHash                  String
  /// Set on every password change; JWTs carry it as the `pwdAt` claim so all
  /// tokens issued before the change become invalid.
  passwordChangedAt             DateTime?
  isActive                      Boolean                        @default(true)
  /// Soft delete: a non-null value blocks login, refresh and every authorized request.
  /// Recoverable by an admin for 30 days (restore endpoint), then considered final.
  deletedAt                     DateTime?
  /// Admin ban: blocks login/refresh/restore permanently; the e-mail cannot re-register.
  bannedAt                      DateTime?
  hireDate                      DateTime?
  terminationDate               DateTime?
  annualLeaveEntitlement        Int                            @default(0)
  /// Profilbild der Personenseite. Es steht als Daten-URL darin (der Browser
  /// verkleinert es vorher auf ein Quadrat) — darum MEDIUMTEXT und nicht die
  /// vorgegebenen 191 Zeichen, in die keine einzige Bildzeile passt.
  profilePictureUrl             String?                        @db.MediumText
  /// Daumennagel desselben Bildes (64 px). Seit dem Profilbild IST das Bild die
  /// Person — es steht in Listen, im Kopfband und an jedem Namensplatz. Das
  /// grosse Bild dorthin zu schicken hiesse, eine Mannschaft von 100 Personen
  /// mit ~10 MB Daten-URLs zu laden; der Daumennagel wiegt rund 2 KB.
  /// Er wird im Browser zusammen mit dem grossen Bild erzeugt.
  profilePictureThumb           String?                        @db.MediumText
  notes                         String?                        @db.Text
  /// Personal module package: subset of module keys this employee can see.
  /// null = no restriction (sees everything the company's category allows).
  moduleKeys                    Json?
  /// Companies (tenants) of the tree this employee may work in / switch to.
  /// null = no restriction (every tenant of the company tree, as before).
  /// Ids outside the own tree are ignored — the list may only ever narrow it.
  allowedTenantIds              Json?
  /// ── Personalmodul (Neubau 16.08.2026, siehe personnel.prisma) ────────────
  /// Fortlaufende Personalnummer je Firmenbaum — die "Mitarbeiter-Nr." der
  /// Berichte. Altbestand hat keine; sie wird beim ersten Speichern vergeben.
  staffNumber                   Int?
  /// Einmaliger QR-Schlüssel: DERSELBE Code meldet an der Anmeldeseite an und
  /// stempelt am Tablet ein/aus. Rotierbar (alter Ausdruck wird damit ungültig).
  qrToken                       String?                        @unique @db.VarChar(64)
  /// STAFF | ADMIN | ACCOUNTANT — wer Anträge freigibt (ADMIN) und wer die
  /// Buchhaltungsstufe des Urlaubswegs führt (ACCOUNTANT).
  staffRole                     String                         @default("STAFF") @db.VarChar(16)
  /// OFFICE | REMOTE — dauerhaft im Homeoffice heisst: der Tag zählt am
  /// Abend als volles Tagessoll, ohne dass jemand einen QR-Code scannt.
  workLocation                  String                         @default("OFFICE") @db.VarChar(16)
  staffTimeEntries              StaffTimeEntry[]               @relation("StaffTimeEntries")
  staffLeaveRequests            StaffLeaveRequest[]            @relation("StaffLeaveRequests")
  staffLeaveApprovals           StaffLeaveRequest[]            @relation("StaffLeaveApprovals")
  staffLeaveAccounting          StaffLeaveRequest[]            @relation("StaffLeaveAccounting")
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @default(now()) @updatedAt
  /// LEGACY — Altdaten des abgelösten Personalmoduls. Die Tabellen bleiben
  /// erhalten (kein Datenverlust), es greift aber kein Code mehr darauf zu.
  attendanceLogs                AttendanceLog[]
  customerNotes                 CustomerNote[]
  uploadedDocs                  Document[]
  tenant                        Tenant                         @relation(fields: [tenantId], references: [id])
  employeeRoles                 EmployeeRole[]
  approvedLeaves                LeaveRequest[]                 @relation("ApprovedLeaves")
  leaveRequests                 LeaveRequest[]                 @relation("EmployeeLeaves")
  createdTenders                Tender[]
  stockMovements                StockMovement[]
  purchaseProposals             PurchaseProposal[]
  projects                      Project[]                      @relation("ProjectManager")
  projectAppointments           Appointment[]                  @relation("ProjectAppointmentTechnician")
  projectAppointmentAssignments ProjectAppointmentAssignment[] @relation("ProjectAppointmentAssignmentTech")
  offerScheduleSlots            OfferScheduleSlot[]            @relation("OfferScheduleSlotTechnician")
  offerScheduleSlotAssignments  OfferScheduleSlotAssignment[]  @relation("OfferScheduleSlotAssignmentTech")
  projectReports                ProjectReport[]
  projectReportLogs             ProjectReportLog[]
  assignedMaintenanceTasks      MaintenanceTask[]              @relation("MaintenanceTech")
  alternativeMaintenanceTasks   MaintenanceTask[]              @relation("MaintenanceAltTech")
  maintenanceTaskAssignments    MaintenanceTaskAssignment[]    @relation("MaintenanceTaskAssignmentTech")
  maintenanceReports            MaintenanceReport[]            @relation("MaintenanceReportTech")
  notifications                 Notification[]                 @relation("EmployeeNotifications")
  assignedServiceCalls          ServiceCall[]                  @relation("ServiceCallTech")
  alternativeServiceCalls       ServiceCall[]                  @relation("ServiceCallAltTech")
  serviceReports                ServiceReport[]                @relation("ServiceReportTech")
  createdSalesOrders            SalesOrder[]
  issuedInvoices                Invoice[]                      @relation("EmployeeIssuedInvoices")
  createdMeetingActivities      MeetingActivity[]              @relation("MeetingActivityCreator")
  meetingParticipations         MeetingActivityParticipant[]   @relation("MeetingParticipantEmployee")
  crmCommunications             CrmCommunication[]             @relation("CrmCommunicationCreator")
  assignedCrmTasks              CrmTask[]                      @relation("CrmTaskAssignee")
  createdCrmTasks               CrmTask[]                      @relation("CrmTaskCreator")
  passwordChangeRequests        PasswordChangeRequest[]        @relation("PasswordChangeRequests")
  passwordChangeDecisions       PasswordChangeRequest[]        @relation("PasswordChangeDecisions")

  @@index([tenantId], map: "Employee_tenantId_fkey")
}

/// Append-only record of sensitive operations: who, when, from which IP,
/// which action, on which entity. Written fire-and-forget by AuditLogService.
model AuditLog {
  id         String   @id
  tenantId   String?
  employeeId String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?  @db.VarChar(512)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([employeeId])
  @@index([action])
}

/// Roles are shared across the whole company tree (one identical list under
/// the main tenant and every sub-tenant); new roles are created under the
/// root. Permissions are part of the shared role; the module package is
/// configured per entity via RoleModuleConfig.
model Role {
  id            String             @id
  tenantId      String
  roleName      String
  /// ROLLENVORLAGE (17.08.2026): die Seitenrechte, wie die Tabelle unter
  /// Einstellungen → Berechtigungen sie zeigt —
  /// { "crm.customers": 2, "inventory.stock": 3 }, 1 ansehen / 2 bearbeiten /
  /// 3 löschen (siehe shared/pageCatalog.ts). Die RolePermission-Zeilen und
  /// das Modulpaket werden daraus ABGELEITET; diese Spalte ist die Fassung,
  /// die bearbeitet wird. null = Altrolle aus der abgelösten Stufenseite; ihre
  /// Karte wird beim Lesen aus den Rechten zurückgerechnet.
  pageLevels    Json?
  /// Feste Administratorrolle des Firmenbaums: alle Seiten, alle Rechte, nicht
  /// änderbar und nicht löschbar. Genau EINE je Stamm.
  isSystemAdmin Boolean            @default(false)
  employees     EmployeeRole[]
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  permissions   RolePermission[]
  moduleConfigs RoleModuleConfig[]

  @@index([tenantId], map: "Role_tenantId_fkey")
}

/// Per-entity module package of a shared role: the same role can enable
/// different modules in each company of the tree (e.g. Offitec, Offitec AG,
/// Offitec Group). No row for (role, tenant) = no restriction there.
model RoleModuleConfig {
  roleId     String
  tenantId   String
  moduleKeys Json
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([roleId, tenantId])
  @@index([tenantId])
}

model Permission {
  id             String           @id
  permissionName String           @unique
  roles          RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model EmployeeRole {
  employeeId String
  roleId     String
  employee   Employee @relation(fields: [employeeId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@id([employeeId, roleId])
  @@index([roleId], map: "EmployeeRole_roleId_fkey")
}

/// Kennwortwunsch aus dem eigenen Profil (17.08.2026): wer nicht verwaltet,
/// ändert sein Kennwort nicht selbst — er BEANTRAGT es. Der Entwurf liegt
/// bereits gehasht hier (Klartext wird nie gespeichert) und wird erst bei der
/// Freigabe auf Employee.passwordHash geschrieben. Verwaltende Personen
/// ändern direkt; für sie entsteht gar kein Antrag.
model PasswordChangeRequest {
  id              String    @id
  tenantId        String
  employeeId      String
  /// Der Entwurf — bcrypt-Hash des gewünschten Kennworts.
  newPasswordHash String
  /// PENDING | APPROVED | REJECTED
  status          String    @default("PENDING") @db.VarChar(16)
  note            String?   @db.Text
  decidedAt       DateTime?
  decidedById     String?
  decisionNote    String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  employee        Employee  @relation("PasswordChangeRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy       Employee? @relation("PasswordChangeDecisions", fields: [decidedById], references: [id])

  @@index([tenantId, status])
  @@index([employeeId, status])
  @@index([decidedById], map: "PasswordChangeRequest_decidedById_fkey")
}

/// LEGACY (abgelöstes Personalmodul) — nur noch Datenhaltung, kein Code mehr.
/// Der Neubau schreibt in StaffLeaveRequest (personnel.prisma).
model LeaveType {
  id       String         @id
  tenantId String
  typeName String
  requests LeaveRequest[]
  tenant   Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "LeaveType_tenantId_fkey")
}

/// LEGACY (abgelöstes Personalmodul) — siehe LeaveType.
model LeaveRequest {
  id           String    @id
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  description  String?   @db.Text
  status       String    @default("Pending")
  approvedById String?
  createdAt    DateTime  @default(now())
  approvedBy   Employee? @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  employee     Employee  @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([approvedById], map: "LeaveRequest_approvedById_fkey")
  @@index([employeeId], map: "LeaveRequest_employeeId_fkey")
  @@index([leaveTypeId], map: "LeaveRequest_leaveTypeId_fkey")
}

/// LEGACY (abgelöstes Personalmodul) — der Neubau schreibt StaffTimeEntry.
model AttendanceLog {
  id               String    @id
  employeeId       String
  logDate          DateTime  @default(now())
  checkInTime      DateTime
  checkOutTime     DateTime?
  /// [{ "start": "ISO", "end": "ISO" | null }] — end null açık mola
  breakPeriodsJson Json?
  /// Çıkış anında hesaplanan net çalışma (mola hariç), saniye
  netWorkSeconds   Int?
  isManualEdit     Boolean   @default(false)
  editedById       String?
  employee         Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "AttendanceLog_employeeId_fkey")
}
