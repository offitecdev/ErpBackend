enum LocationType {
  MAIN_WAREHOUSE
  SUB_WAREHOUSE
  STATION_BUFFER
  PROJECT_RESERVE
}

enum MovementType {
  IN
  OUT
  TRANSFER
  RETURN
  ADJUSTMENT
}

enum ProposalStatus {
  PENDING
  APPROVED
  CONVERTED
  REJECTED
}

model Location {
  id               String       @id
  tenantId         String
  parentLocationId String?
  locationName     String
  locationType     LocationType
  isActive         Boolean      @default(true)

  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  parentLocation Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  subLocations   Location[] @relation("LocationHierarchy")

  balances         StockBalance[]
  movementsSource  StockMovement[]   @relation("SourceLocation")
  movementsDest    StockMovement[]   @relation("DestLocation")
  articleSuppliers ArticleSupplier[]

  @@index([tenantId])
  @@index([parentLocationId])
}

model StockBalance {
  id               String   @id
  tenantId         String
  articleId        String
  locationId       String
  currentQuantity  Float    @default(0)
  reservedQuantity Float    @default(0)
  updatedAt        DateTime @updatedAt

  article  Article  @relation(fields: [articleId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([articleId, locationId])
  @@index([tenantId])
}

model StockMovement {
  id                    String       @id
  tenantId              String
  articleId             String
  movementType          MovementType
  quantity              Float
  unitCost              Float? // Manuel girişlerde bu partinin birim maliyeti (ağırlıklı ortalama için)
  sourceLocationId      String?
  destinationLocationId String?
  transactionDate       DateTime     @default(now())
  employeeId            String
  supplierId            String? // Hareketin tedarikçisi (giriş/alış hareketlerinde)
  referenceId           String? // Proje ID, İhale ID veya Üretim Emri ID
  description           String?      @db.Text

  article             Article   @relation(fields: [articleId], references: [id])
  sourceLocation      Location? @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation Location? @relation("DestLocation", fields: [destinationLocationId], references: [id])
  employee            Employee  @relation(fields: [employeeId], references: [id])
  supplier            Supplier? @relation(fields: [supplierId], references: [id])

  @@index([tenantId])
  @@index([articleId])
  @@index([employeeId])
  @@index([supplierId])
}

model PurchaseProposal {
  id               String         @id
  tenantId         String
  articleId        String
  proposedQuantity Float
  supplierId       String? // İleride Supplier tablosu gelince bağlanabilir
  status           ProposalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  resolvedAt       DateTime?
  resolvedByEmpId  String?

  article    Article   @relation(fields: [articleId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  resolvedBy Employee? @relation(fields: [resolvedByEmpId], references: [id])

  @@index([tenantId])
  @@index([articleId])
  @@index([supplierId])
}

/// Tedarikçi. Adres AYRI BİLEŞENLER olarak tutulur (Customer ile aynı desen):
/// `companyName` = firma/ad, `address` = sokak + bina no, `addressSupplement` =
/// adres eki / daire, ardından PLZ / şehir / eyalet / ülke. Tek bir "adres"
/// serbest metni YOKTUR — aynı anlamı taşıyan ikinci bir alan tutulmaz.
/// Görüntülemede (ekran ve PDF) bu bileşenler en fazla 2 satıra indirgenir:
/// `formatAddressLines()` (frontend `utils/address.ts`, backend `shared`).
model Supplier {
  id                String   @id
  tenantId          String
  companyName       String
  contactName       String?
  email             String?
  phone             String?
  address           String?  @db.Text // sokak + bina no
  addressSupplement String? // adres eki / daire
  postalCode        String?
  city              String?
  state             String? // eyalet / kanton / bölge
  country           String?
  notes             String?  @db.Text
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  articleSuppliers  ArticleSupplier[]
  purchaseProposals PurchaseProposal[]
  stockMovements    StockMovement[]

  @@unique([tenantId, companyName])
  @@index([tenantId])
}

/// Tedarik talebi (Supply Request). Bir ürün/malzeme minimum ya da kritik stok
/// seviyesine düştüğünde kullanıcının bir tedarikçiye açtığı talep. Ürün/tedarikçi
/// bilgileri anlık görüntü (snapshot) olarak saklanır; ilişki join'i gerekmeden
/// listelenebilir (aşırı veri çekmemek için). articleId/materialId/supplierId
/// yalnızca "stoğa ekle" ekranını doldurmak ve talebi teslim almak için tutulur.
model SupplyRequest {
  id                String    @id
  tenantId          String
  itemType          String    @default("PRODUCT") // PRODUCT | MATERIAL
  articleId         String?
  materialId        String?
  itemName          String
  itemCode          String?
  unit              String?
  supplierId        String?
  supplierName      String?
  supplierEmail     String?
  requestedQuantity Float     @default(0)
  emailSubject      String?   @db.Text
  emailBody         String?   @db.Text
  emailSent         Boolean   @default(false)
  status            String    @default("PENDING") // PENDING | RECEIVED | CANCELLED
  createdByEmpId    String?
  createdAt         DateTime  @default(now())
  receivedAt        DateTime?
  receivedByEmpId   String?

  @@index([tenantId])
  @@index([status])
  @@index([articleId])
  @@index([supplierId])
}

/// Satın alma siparişi (Purchase Order). Bir tedarikçiye gönderilen sipariş;
/// tek sipariş = tek tedarikçi. Ürün satırları anlık görüntü (snapshot) olarak
/// JSON kolonunda saklanır (SupplyRequest emsali: FK yok, listeleme join'siz).
/// status: PENDING | TO_BE_STOCKED | COMPLETED | UPDATED
///  - TO_BE_STOCKED: kullanıcı popup'tan elle işaretler (mail göndermek durumu DEĞİŞTİRMEZ)
///  - UPDATED: mail gönderildikten sonra ürünler değişirse (revision+1); ad değişikliği durumu etkilemez
///  - COMPLETED: stoğa eklendiğinde (mark-stocked)
model PurchaseOrder {
  id              String    @id
  tenantId        String
  referenceNumber String // "Auftrag" BE-2026-0001 — tenant başına benzersiz, kullanıcı düzenleyebilir
  quoteNumber     String? // opsiyonel teklif numarası (PDF'te görünür)
  orderedByName   String? // "Besteller" — siparişi veren kişi (varsayılan: oturumdaki kullanıcı)
  projectName     String? // tedarik edilen projenin adı (PDF kapak kartında)
  status          String    @default("PENDING")
  supplierId      String?
  supplierName    String // snapshot
  supplierEmail   String?
  supplierAddress String?   @db.Text // snapshot — bileşenlerden kurulmuş, satır başına \n (PDF alıcı bloğu)
  // JSON [{itemType, articleId?, code, serialNumber?, name, quantity, unit?,
  //        grossPrice, netPrice, discount, discount2, discount3, vatRate,
  //        lineTotal, lineVat}]
  // discount/discount2/discount3: SIRAYLA uygulanan yüzdeler (teklif
  // directDiscount/extraDiscount deseniyle aynı) — lineTotal net tutardır.
  items           String    @db.LongText
  // JSON [{name, amount}] — sipariş düzeyinde EK ÜCRETLER (nakliye, ambalaj…).
  // Kalem değildir: miktarı/indirimi/KDV'si yoktur, genel toplama net olarak
  // eklenir (`totalFees`).
  additionalFees  String?   @db.Text
  currency        String    @default("CHF")
  totalNet        Float     @default(0)
  totalGross      Float     @default(0)
  totalVat        Float     @default(0)
  totalFees       Float     @default(0) // ek ücretlerin toplamı — genel toplam = totalNet + totalFees + totalVat
  revision        Int       @default(0) // >0 → sonraki mailler "güncellendi" etiketi taşır
  emailSentAt     DateTime?
  emailRecipient  String?
  stockedAt       DateTime?
  createdByEmpId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, referenceNumber])
  @@index([tenantId])
  @@index([status])
  @@index([supplierId])
}

model ArticleSupplier {
  id                String    @id
  tenantId          String
  articleId         String
  supplierId        String
  locationId        String?
  supplierSku       String?
  purchasePrice     Float     @default(0)
  quantity          Float     @default(0)
  remainingQuantity Float     @default(0)
  currency          String    @default("CHF")
  lastPurchaseDate  DateTime?
  stockMovementId   String?
  notes             String?   @db.Text
  isPreferred       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  article  Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  @@index([tenantId])
  @@index([articleId])
  @@index([supplierId])
  @@index([locationId])
}
