/// ── OSP-INTEGRATION (Offitec Selection Platform, 04.09.2026) ────────────────
/// Die OSP schickt Offertanfragen ("Get Offer") als Webhook zu uns; wir melden
/// den Bearbeitungsstand zurück (created / under review / offer has been sent
/// — siehe offer-integration-api.md). Beides ist Server-zu-Server über einen
/// gemeinsamen Schlüssel, NIE über das Benutzer-JWT.
///
/// Die Einstellungen hängen am WURZEL-Mandanten des Firmenbaums: EIN Feed je
/// Firma, und `tenantIds` sagt, welche Mandanten des Baums die OSP-Seite sehen
/// und bearbeiten dürfen (Einstellungen → Module → Verkauf → OSP).

model OspSetting {
  id         String   @id
  /// Wurzel-Mandant des Firmenbaums — eine Zeile je Firma.
  tenantId   String   @unique
  /// Erwarteter X-OSP-Integration-Key des EINGEHENDEN Webhooks. Leer = der
  /// Webhook nimmt für diese Firma nichts an (niemals offen durchfallen).
  webhookKey String?  @db.VarChar(191)
  /// Basisadresse des OSP-Backends für AUSGEHENDE Statusmeldungen,
  /// z. B. https://api.osp.offitec.ch — leer = nichts melden.
  ospBaseUrl String?  @db.VarChar(255)
  /// Schlüssel, den WIR bei /integration/** mitschicken.
  ospApiKey  String?  @db.Text
  /// JSON-Liste der Mandanten-Ids, die am OSP-Modul teilnehmen (Auswahl im
  /// Einstellungsreiter). Leer/null = nur der Wurzel-Mandant selbst.
  tenantIds  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// EINE Anfrage der OSP = EIN PROJEKT (Vertragsfassung 4, 20.09.2026). Wer
/// drüben "Get Offer" drückt, fragt nicht eine Einheit an, sondern sein ganzes
/// Projekt — und bekommt darauf EINE Antwort. Der Stand lebt deshalb am
/// PROJEKT, und `reference` ist seither schlicht die 7-stellige Projektnummer.
/// Die angefragten Einheiten hängen als `units` darunter (OspUnit).
///
/// Ältere Zeilen tragen noch die zusammengesetzte Referenz "4820193-57" einer
/// einzelnen Einheit. Sie bleiben gültig: die OSP nimmt diese Form auf den
/// Statuswegen weiter an und meint damit das Projekt (§0). Die Migration
/// `20260920090000_osp_contract_v4` hat sie, wo es eindeutig war, zu einer
/// Projektzeile mit einer Einheit zusammengelegt.
///
/// ⚠ OSP-Zeilen legen NIE Artikel oder Bestand an: der Import erzeugt eine
/// Offerte mit reinen Textpositionen (rowType CUSTOM) — nur für diese Offerte.
model OspDocument {
  id                  String    @id
  /// Wurzel-Mandant (Eigentümer des Feeds) — siehe OspSetting.
  tenantId            String
  /// Der Schlüssel jeder Statusmeldung: die PROJEKTNUMMER (§0). Alte Zeilen
  /// tragen hier noch die zusammengesetzte Form "4820193-57" — auch die
  /// adressiert drüben das Projekt.
  reference           String
  /// Die 7-stellige Projektnummer.
  projectNumber       String
  /// VERALTET (20.09.2026): die Dokument-Id der einen angefragten Einheit.
  /// Seit der vierten Vertragsfassung hängen die Einheiten als `units`
  /// darunter; die Spalte bleibt stehen, damit alte Zeilen ihre Herkunft
  /// behalten.
  documentId          String?
  /// Die eigene Projekt-Id der OSP (§1 `projectId`) — für immer stabil und
  /// für sich eindeutig, anders als die Projektnummer nicht sprechend.
  ospProjectId        Int?
  projectName         String    @default("")
  /// Anfragende Person (OSP-Konto) — wird beim Import als manueller Kunde
  /// vorgeschlagen, aber NIE als CRM-Kunde gespeichert.
  requesterFirstName  String?
  requesterLastName   String?
  requesterEmail      String?
  /// Firma des anfragenden OSP-Kontos. Bei user-Konten ist dies der
  /// vorgeschlagene Kundenname der Offerte, nicht der Personenname.
  company             String?
  /// Rufnummer FÜR DIESES PROJEKT (Vertrag §1 `phone`) — nicht zwingend die
  /// des OSP-Kontos.
  phone               String?
  /// Adressblock des AUFTRAGS, nicht des Kontos: die anfragende Person darf
  /// eine Anlage in einem Land offerieren, in dem sie nicht wohnt (§1).
  /// `address` ist die Projektadresse (Vertrag `projectAddress`); Liefer- und
  /// Rechnungsadresse kommen bereits aufgelöst an — wo die Person "gleich wie
  /// Projekt" gewählt hat, wiederholen sie die Projektadresse schlicht.
  country             String?
  city                String?
  address             String?   @db.Text
  shippingAddress     String?   @db.Text
  billingAddress      String?   @db.Text
  postalCode          String?
  /// OSP-Kontotyp ("user" | "admin").
  userType            String?
  /// "chiller" | "heat pump" | "dry cooler".
  category            String?
  /// "air to water" | "water to water".
  unitType            String?
  model               String?
  /// created_at aus der OSP (Projektanlage drüben).
  ospCreatedAt        DateTime?
  /// Unser Bearbeitungsstand: LISTED → IN_OFFER → SENT → APPROVED.
  /// Er wird NIE von Hand gesetzt, sondern folgt der Arbeit (§ "Required
  /// workflow"): eine Anfrage ohne Verkäufer:in ist LISTED ("Gelistet"), mit
  /// gewählter Verkäufer:in IN_OFFER ("Verkäufer zugewiesen", drüben "under
  /// review"), und sobald die Angebotsmail hinaus ist SENT ("Gesendet",
  /// drüben "offer has been sent"). APPROVED bleibt intern. WITHDRAWN steht daneben: die
  /// anfragende Person hat die Anfrage drüben zurückgezogen (§1b).
  status              String    @default("LISTED")
  /// Verkäufer:in — aus dem Personalverzeichnis gewählt; die E-Mail ist das,
  /// was die OSP als salesmanEmail sieht.
  salespersonId       String?
  salespersonEmail    String?
  salespersonName     String?
  /// Das §3-"salesman"-Objekt, wie es gemeldet wird: { email, name, surname,
  /// phone }. Hat die Adresse drüben KEIN OSP-Konto, ist genau das die
  /// Visitenkarte, die die anfragende Person zu sehen bekommt — sonst sähe
  /// sie eine nackte E-Mail-Adresse. Als Ganzes abgelegt, weil der Vertrag
  /// das Objekt als Ganzes verlangt (und später ein Bild dazukommen darf).
  salespersonProfile  Json?
  /// VERALTET (19.09.2026): die Projektleitung war eine zweite, rein interne
  /// Zuständigkeit an der Anfrage. Gemeldet wurde sie nie, und gewählt wird
  /// jetzt nur noch die Verkäuferin/der Verkäufer — die eine Person, die die
  /// Offerte macht. Die Spalten bleiben stehen wie `salespersonRole`: sie
  /// werden nicht mehr geschrieben und nicht mehr gelesen, damit alte Zeilen
  /// behalten, was einmal an ihnen stand.
  projectManagerId    String?
  projectManagerEmail String?
  projectManagerName  String?
  /// VERALTET (05.09.2026): Rolle der einen zuständigen Person. Wird nicht mehr
  /// geschrieben und nicht mehr gelesen — die Spalte bleibt nur stehen, damit
  /// alte Zeilen ihren Ursprung behalten (die Migration hat PROJECT_MANAGER-
  /// Zeilen bereits nach projectManager* umgehängt).
  salespersonRole     String    @default("SALES")
  /// Die aus dem Import entstandene Offerte (Belegspalte der Liste).
  tenderId            String?
  tenderNumber        String?
  /// ── DATENBLATT (07.09.2026) — VERALTET (20.09.2026) ───────────────────
  /// Solange eine Anfrage EINE Einheit war, hing ihr Datenblatt hier. Seit der
  /// vierten Vertragsfassung hat jede Einheit ihr eigenes (OspUnit); die
  /// Migration hat den Inhalt dieser Spalten dorthin gehoben. Gelesen werden
  /// sie nicht mehr — stehen bleiben sie, damit alte Zeilen erzählen können,
  /// woher ihre Offerte kam.
  datasheetUrl        String?   @db.Text
  datasheetFile       String?
  datasheetFetchedAt  DateTime?
  /// Warum das Holen bzw. Auslesen scheiterte — steht an der Zeile, wie bei
  /// den Statusmeldungen auch.
  datasheetError      String?   @db.Text
  /// Die aus dem PDF gelesenen Angaben (Leistung, COP, Medium, Technologie,
  /// Schalldruck, Abmessungen, Gewicht). Sie füllen das Import-Fenster vor —
  /// getippt wird nur noch, was das Datenblatt nicht hergibt.
  datasheetSpecs      Json?
  /// Der unveränderte Webhook-Eintrag. Die OSP schickt mehr Felder, als der
  /// Vertrag beschreibt (company, city, userType …); ohne diese Kopie ist
  /// hinterher nicht mehr feststellbar, was tatsächlich geliefert wurde.
  rawPayload          Json?
  /// ── ZURÜCKGEZOGEN (§1b) ───────────────────────────────────────────────
  /// Die anfragende Person nimmt ihre Anfrage im OSP zurück. Die OSP räumt
  /// ihre Seite ZUERST und bedingungslos ab; wir bekommen nur noch Bescheid.
  /// Gelöscht wird bei uns nichts — die Zeile behält Offerte und Datenblatt
  /// und wechselt auf WITHDRAWN, damit niemand weiterarbeitet.
  withdrawnAt         DateTime?
  withdrawnByName     String?
  withdrawnByEmail    String?
  /// Der Stand, in dem die Anfrage zurückgezogen wurde ("offer request sent"
  /// oder "under review" — nie "offer has been sent").
  withdrawnFromStatus String?
  /// ── ÜBERARBEITET (§1a) ────────────────────────────────────────────────
  /// Dieselbe Anfrage kommt neu berechnet noch einmal. Die OSP setzt drüben
  /// auf "created" zurück (Verkäufer:in bleibt); hier bleibt der Stand, aber
  /// die Zeile sagt sichtbar, dass die Einheit sich geändert hat.
  revisedAt           DateTime?
  revisionCount       Int       @default(0)
  /// Wann die Überarbeitung an der OFFERTE zur Kenntnis genommen wurde. Die
  /// Offerte warnt, solange `revisedAt` jünger ist als dieser Stempel — das
  /// alte Datenblatt gilt dann nicht mehr, und niemand soll aus ihm heraus
  /// weiterofferieren, ohne es gesehen zu haben.
  revisionSeenAt      DateTime?
  /// Was die letzte Überarbeitung am PROJEKT bewegt hat (§1a `changes`):
  /// ["project name","phone","city"]. Genau diese Liste hat die anfragende
  /// Person drüben auch zu sehen bekommen — beides kommt aus demselben
  /// Änderungsprotokoll und kann darum nicht auseinanderlaufen. Ein
  /// unbekannter Eintrag heisst "sonst etwas hat sich geändert", nie ein
  /// Fehler: die Liste ist eine Beschreibung, kein geschlossener Wortschatz.
  changes             Json?
  /// ── AKTIVITÄTSSTROM (§1c) ─────────────────────────────────────────────
  /// Der Strom meldet auch Einheiten, die zu einer Anfrage gehören, die wir
  /// halten: dann ist das Datenblatt hier überholt UND seine alte Adresse
  /// drüben gelöscht. Das ist KEINE neue Anfrage und kein Stand — nur der
  /// Hinweis, dass die Datei neu gerendert wurde.
  feedRevisedAt       DateTime?
  /// Warum (RECALCULATED, PROJECT_INFO_CHANGED …) — die Wortliste des §1c.
  feedRevisedSource   String?
  /// Letzte erfolgreich an die OSP gemeldete Statusform (created/under
  /// review/offer has been sent) + Zeitpunkt/Fehler der letzten Meldung.
  lastReportedStatus  String?
  lastReportAt        DateTime?
  lastReportError     String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  /// Die angefragten Einheiten des Projekts (§1 `projectDetails`).
  units               OspUnit[]

  @@unique([tenantId, reference])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, projectNumber])
  @@index([tenderId])
}

/// ── DIE ANGEFRAGTE EINHEIT (§1 `projectDetails`, 20.09.2026) ────────────────
/// Ein Projekt hält mehrere Einheiten, und jede bringt ihr eigenes Datenblatt
/// und ihre eigenen berechneten Zahlen mit. Angefragt werden sie NIE einzeln:
/// die Anfrage ist das Projekt (OspDocument), diese Zeilen sind das, was darin
/// zu offerieren ist — eine Offertposition je Einheit.
///
/// Die Zahlen sind BERECHNETE Werte am eingegebenen Betriebspunkt, aus
/// derselben Momentaufnahme gelesen, aus der das PDF gerendert wurde. Sie
/// gelten deshalb vor dem, was aus dem PDF-Text zu lesen wäre; das Auslesen
/// füllt nur noch auf, was der Vertrag nicht kennt (das Medium).
model OspUnit {
  id                 String      @id
  /// Wurzel-Mandant — wie an der Anfrage (Eigentümer des Feeds).
  tenantId           String
  /// Die Anfrage (das Projekt), zu der diese Einheit gehört.
  requestId          String
  request            OspDocument @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Die eigene Dokument-Id der OSP (§1 `projectDetails[].id`) — über alle
  /// Projekte eindeutig und über die Lebensdauer der Einheit stabil.
  ospDocumentId      String
  /// Name und Modell der Einheit. §1 nennt sie NICHT; sie kommen aus dem
  /// Aktivitätsstrom (§1c), sobald derselbe Beleg dort auftaucht — sonst
  /// bleibt der Positionstitel der Projektname.
  unitName           String?
  unitModel          String?
  /// Adresse des Datenblatt-PDF drüben. Sie ist NICHT dauerhaft: jede
  /// Neuberechnung rendert neu und LÖSCHT die alte Datei (§1c) — deshalb
  /// liegt die Datei bei uns.
  pdfUrl             String?     @db.Text
  datasheetFile      String?
  datasheetFetchedAt DateTime?
  datasheetError     String?     @db.Text
  /// Die berechneten Angaben (Leistung, COP/EER, Technologie, Schalldruck,
  /// Abmessungen, Gewicht) — Grundlage der Positionsbeschreibung.
  datasheetSpecs     Json?
  /// Was die letzte Überarbeitung an DIESER Einheit bewegt hat (§1a):
  /// ["recalculated"], ["unit options"] … Eine LEERE Liste ist eine Aussage:
  /// das Datenblatt wurde durch eine Änderung am PROJEKT neu gerendert, an
  /// der Einheit selbst hat sich nichts bewegt.
  changes            Json?
  /// Wann die Einheit zuletzt mit einer Anfrage kam (§1/§1a). Eine
  /// Überarbeitung schickt nur die Einheiten, die sich geändert haben — an
  /// den übrigen bleibt dieser Stempel stehen.
  receivedAt         DateTime?
  /// Der unveränderte Eintrag aus dem Webhook.
  rawPayload         Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([requestId, ospDocumentId])
  @@index([tenantId, ospDocumentId])
}

/// ── DER AKTIVITÄTSSTROM (§1c, 20.09.2026) ──────────────────────────────────
/// Was drüben gerechnet wird, sobald es gerechnet wird — gebündelt alle 30
/// Sekunden. Das ist AUSDRÜCKLICH KEINE Anfrage: niemand hat um eine Offerte
/// gebeten, es hängt kein Stand daran, und die OSP erwartet keine Antwort.
/// Diese Zeilen dürfen deshalb NIE in der Anfrageliste landen, aus der der
/// Verkauf arbeitet — sie stehen in ihrem eigenen Reiter.
///
/// Der Strom ist "mindestens einmal": bleibt unsere Quittung unterwegs, kommt
/// derselbe Beleg noch einmal. Darum ist (tenantId, ospDocumentId) eindeutig
/// und jede Lieferung ein Upsert.
model OspFeedEntry {
  id                 String    @id
  /// Wurzel-Mandant (Eigentümer des Feeds).
  tenantId           String
  /// Die eigene Dokument-Id der OSP — der Schlüssel dieser Zeile.
  ospDocumentId      String
  ospProjectId       Int?
  projectNumber      String?
  projectName        String?
  projectCreatedAt   DateTime?
  /// Das OSP-Konto, dem das Projekt gehört. `email` ist das einzige Feld, das
  /// je Person eindeutig ist — darauf wird verglichen, wer da rechnet.
  requesterFirstName String?
  requesterLastName  String?
  requesterEmail     String?
  company            String?
  unitName           String?
  unitModel          String?
  pdfUrl             String?   @db.Text
  /// Warum der Beleg im Bündel liegt: CALCULATION / ADDED_TO_PROJECT (NEU)
  /// oder RECALCULATED / OPTIONS_CHANGED / CUSTOM_VALUES_CHANGED /
  /// PROJECT_INFO_CHANGED / LANGUAGE_CHANGED (Änderung an einem Beleg, den
  /// wir schon kennen). Jeder dieser Werte heisst: die PDF-Adresse hat sich
  /// bewegt und die alte ist gelöscht.
  source             String    @default("CALCULATION")
  filedAt            DateTime?
  /// Die berechneten Zahlen, so wie der Strom sie nennt (Zeichenketten mit
  /// Punkt als Dezimaltrenner; `null` heisst "gibt es an dieser Einheit
  /// nicht", nie 0).
  coolingCapacityKw  String?
  heatingCapacityKw  String?
  eer                String?
  cop                String?
  /// Wann wir den Beleg zum ersten Mal gesehen haben — der Strom sagt selbst
  /// NICHT, ob ein Projekt für uns neu ist ("das ist eine Tatsache über eure
  /// Aufzeichnungen, nicht über unsere").
  firstSeenAt        DateTime  @default(now())
  rawPayload         Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([tenantId, ospDocumentId])
  @@index([tenantId, filedAt])
  @@index([tenantId, projectNumber])
}
