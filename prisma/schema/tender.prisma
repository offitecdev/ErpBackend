enum TenderFormat {
  SIA451
  CRBX
}

enum TenderStatus {
  Draft
  Approved
  Exported
}

model Tender {
  id                        String       @id
  tenantId                  String
  customerId                String?
  projectId                 String?
  // Teklif kodu — AN-2026-10001. Sunucuda DocumentCounter'dan üretilir, her dilde
  // aynıdır ve istemciden gelen değer YOK SAYILIR. Bir teklifin tüm sürümleri
  // (version 1,2,3…) AYNI tenderNumber'ı paylaşır; bu yüzden tekil değildir.
  tenderNumber              String
  // Yeni numaralandırmadan önceki kod (A-2026-4474, TKF-…, CSV içe aktarımının
  // dış referansı). Eski bağlantı/arama ve içe aktarım eşleşmesi için saklanır.
  legacyNumber              String?
  version                   Int          @default(1)
  format                    TenderFormat
  validUntil                DateTime?
  sourceCreatedAt           DateTime?
  orderDate                 DateTime?
  billingAddress            String?      @db.Text
  // Projektadresse (installation/Montage). Historically deliveryAddress held this;
  // deliveryAddress is now the actual Lieferadresse.
  installationAddress       String?      @db.Text
  deliveryAddress           String?      @db.Text
  billingSameAsInstallation Boolean?     @default(false)
  internalDeliveryDate      DateTime?
  priceList                 String?
  paymentTerms              String?
  commissionNumber          String?
  // Kundenreferenz — the reference the CUSTOMER supplied ("Referenz" on the
  // offer PDF). Distinct from commissionNumber (our commission label).
  customerReference         String?
  // Currency the offer is denominated in (CHF/EUR/USD/GBP/TRY). Symbol-only:
  // it changes how amounts are displayed/exported, not their numeric value.
  currency                  String?

  // Document-level direct discount (%) applied to the net total in the offer summary.
  directDiscount       Float?                @default(0)
  // Optional custom display name for the direct discount (e.g. "Winteraktion").
  directDiscountLabel  String?
  // Second document-level discount (%) applied SEQUENTIALLY after directDiscount
  // (100 → -20% → 80 → -10% → 72). Same factor scales net and VAT.
  extraDiscount        Float?                @default(0)
  extraDiscountLabel   String?
  // Belge düzeyi iskonto YIĞINI — JSON [{name, kind, value}] (kind: PERCENT |
  // AMOUNT), SIRAYLA uygulanır. Düzenlenebilir kaynak budur; `directDiscount`
  // bu listenin birleşik yüzdesini yansıtır (eski tüketiciler onu okumaya
  // devam eder) ve liste kullanıldığında `extraDiscount` 0'a çekilir.
  totalDiscounts       String?               @db.Text
  // Payment schedule as a JSON array of stage percents, e.g. "[30,20,10,40]".
  // Stages must sum to 100. Null = no schedule (free-form invoicing).
  paymentStages        String?
  salespersonName      String?
  sourceStatus         String?
  sourceCompany        String?
  shippingTerms        String?
  shippingWeight       Float?
  fiscalPosition       String?
  salesTeam            String?
  onlineSignature      Boolean?
  onlinePayment        Boolean?
  // ── Optional PDF content blocks ──
  // Rich text (HTML: bold / italic / colour). All three are optional and the
  // document renders without them.
  // Intro text (Einleitungstext) printed on page 1, directly below the offer
  // title — not on a separate page. Usually applied from a TenderTextTemplate.
  coverLetter          String?               @db.LongText
  // Note printed after the totals, at the end of the document.
  closingNote          String?               @db.LongText
  // Images printed after the closing note — a JSON array of data URIs.
  closingImages        String?               @db.LongText
  sourceTotal          Float?
  sourceNetAmount      Float?
  sourceTaxAmount      Float?
  sourceRecurringTotal Float?
  sourceMargin         Float?
  status               TenderStatus          @default(Draft)
  // Kopya (CC) alıcıları — takvimdeki Appointment/MeetingActivity ile AYNI
  // biçim: JSON dizi (["planer@firma.ch"]). Teklifin bütün müşteri mailleri
  // (teklif maili ve otomatik sipariş bildirimi) bu listeyi CC'ler; alıcı (To)
  // her zaman müşterinin kendi adresidir.
  ccEmails             Json?
  offerMailSentAt      DateTime?
  offerAcceptedAt      DateTime?
  offerMailRecipient   String?
  offerAcceptanceToken String?               @unique @db.VarChar(128)
  createdAt            DateTime              @default(now())
  createdByEmployeeId  String
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  customer             Customer?             @relation(fields: [customerId], references: [id])
  createdBy            Employee              @relation(fields: [createdByEmployeeId], references: [id])
  positions            Position[]
  usedMaterials        TenderMaterialUsage[]
  salesOrder           SalesOrder?
  project              Project?
  offerScheduleSlots   OfferScheduleSlot[]

  @@index([tenantId])
  @@index([customerId])
  // Liste tenant içinde sıralanır; tek kolonluk tenantId indeksi sıralamayı
  // karşılamadığı için her sayfa filesort'a düşüyordu.
  @@index([tenantId, createdAt])
  @@index([tenantId, tenderNumber])
  @@index([tenantId, legacyNumber])
}

model Position {
  id               String     @id
  tenantId         String
  tenderId         String
  parentPositionId String?
  rowType          String     @default("SECTION")
  sourceArticleId  String?
  displayOrder     Int        @default(0)
  npkCode          String?
  positionNumber   String
  shortDescription String
  longDescription  String?    @db.Text
  quantity         Float      @default(0)
  unit             String?
  hierarchyLevel   Int        @default(0)
  imageUrl         String?    @db.LongText
  unitPrice        Float?
  // Satırın iskontolarının BİRLEŞİK yüzdesi. Fiyat matematiğinin tek girdisi
  // budur (quantity × unitPrice × (1 − discount/100)); `discounts` listesinden
  // sunucuda yeniden türetilir.
  discount         Float?     @default(0)
  // En fazla 5 satır iskontosu — JSON [{name, kind, value}] (kind: PERCENT |
  // AMOUNT), miktar × birim fiyat üzerine SIRAYLA uygulanır.
  discounts        String?    @db.Text
  taxRate          Float?     @default(0)
  tender           Tender     @relation(fields: [tenderId], references: [id])
  parentPosition   Position?  @relation("PositionHierarchy", fields: [parentPositionId], references: [id])
  subPositions     Position[] @relation("PositionHierarchy")

  calculation     CalculationItem?
  articleMappings PositionArticleMapping[]

  @@index([tenderId])
  @@index([parentPositionId])
  @@index([sourceArticleId])
  @@index([tenderId, parentPositionId, displayOrder])
}

model CalculationItem {
  id                   String   @id
  positionId           String   @unique
  materialCost         Float    @default(0)
  laborCost            Float    @default(0)
  overheadCost         Float    @default(0)
  riskAmount           Float    @default(0)
  additionalCost       Float    @default(0)
  profitMargin         Float    @default(0)
  totalCalculatedPrice Float    @default(0)
  position             Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model Article {
  id                 String    @id
  tenantId           String
  articleCode        String
  systemBarcode      String?   @unique
  supplierBarcode    String?
  name               String
  description        String?   @db.Text
  baseCost           Float     @default(0)
  salePrice          Float     @default(0)
  defaultSupplierId  String?
  unit               String
  imageUrl           String?   @db.LongText
  category           String?
  /// Product/service classification: PRODUCT | SERVICE (the legacy MATERIAL
  /// value was folded into PRODUCT when the separate materials category was
  /// removed, 2026-08-14). Toggled from the product detail screen.
  itemType           String    @default("PRODUCT")
  status             String    @default("ACTIVE")
  lastPurchaseDate   DateTime?
  isActive           Boolean   @default(true)
  minStockLevel      Float     @default(0)
  criticalStockLevel Float     @default(0)
  maxStockLevel      Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  positionMappings PositionArticleMapping[]

  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  purchaseProposals    PurchaseProposal[]
  articleSuppliers     ArticleSupplier[]
  reportMaterials      ReportMaterial[]
  maintenanceMaterials MaintenanceMaterial[]
  serviceMaterials     ServiceMaterial[]
  tenderUsages         TenderMaterialUsage[]
  extraMaterialUsages  ProjectExtraMaterial[]
  variations           ProjectVariation[]

  @@unique([tenantId, articleCode])
  @@index([tenantId])
  @@index([tenantId, deletedAt, createdAt])
  // Ürün/malzeme listesi varsayılan olarak tenant + tip içinde en yeni kaydı açar.
  @@index([tenantId, itemType, deletedAt, createdAt, id])
}

model PositionArticleMapping {
  id                 String @id
  positionId         String
  articleId          String
  quantityMultiplier Float  @default(1)
  discount           Float? @default(0)

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  article  Article  @relation(fields: [articleId], references: [id])

  @@index([positionId])
  @@index([articleId])
}

/// Tender-level extra product usage ("Materialien" tab of the quote settings).
/// Since the material/product merge (2026-08-14) the rows reference Article —
/// the API keeps accepting `materialId` on the wire for compatibility.
model TenderMaterialUsage {
  id          String   @id
  tenderId    String
  articleId   String
  quantity    Float
  unitCost    Float    @default(0)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  tender  Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id])

  @@index([tenderId])
  @@index([articleId])
}

// Tenant-wide reusable offer-mail drafts (subject + message templates).
// NOT tied to a single tender — the mail composer of every tender can list,
// apply, edit and delete them.
model TenderMailDraft {
  id        String   @id
  tenantId  String
  subject   String   @default("")
  message   String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Tenant-wide reusable intro-text templates (Textbausteine) for the offer's
// Einleitungstext. `isDefault` marks the one pre-filled into new offers; the
// picker popup lists all of them and "+" adds more.
model TenderTextTemplate {
  id        String   @id
  tenantId  String
  title     String   @default("")
  // Rich HTML (bold / italic / bullet lists) — same dialect as coverLetter.
  content   String?  @db.LongText
  isDefault Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model TenderActivityLog {
  id          String   @id
  tenantId    String
  tenderId    String
  positionId  String?
  mappingId   String?
  articleId   String?
  employeeId  String
  actionType  String
  fieldName   String?
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenderId])
  @@index([positionId])
  @@index([mappingId])
  @@index([articleId])
}

// Durable, small derivatives used by offer PDFs. This is a separate table so
// ordinary Article/Position reads never accidentally select another image blob.
model PdfImageThumbnail {
  id            String   @id
  tenantId      String
  sourceType    String
  sourceId      String
  sourceVersion String?
  imageUrl      String   @db.LongText
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, sourceType, sourceId])
}
